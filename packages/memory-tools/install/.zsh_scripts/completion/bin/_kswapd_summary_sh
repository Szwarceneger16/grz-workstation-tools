#compdef kswapd-summary.sh

_kswapd_summary_sh() {
  emulate -L zsh
  setopt noshwordsplit

  local cur=${words[CURRENT]:-}

  if (( CURRENT == 2 )); then
    case $cur in
      -*)
        compadd -Q -S '' -- -h --help
        ;;
      *)
        compadd -Q -S '' -- 1 2 5 10
        _message 'interval_s (sekundy; dla pidstat sensownie >= 1)'
        ;;
    esac
    return
  fi

  if (( CURRENT == 3 )); then
    compadd -Q -S '' -- 30 60 120 300 600 900 1800
    _message 'duration_s (sekundy)'
    return
  fi

  if (( CURRENT == 4 )); then
    compadd -Q -S '' -- 0.5 1 2 5 10
    _message 'threshold_pct (procent CPU)'
    return
  fi

  case $cur in
    -*) compadd -Q -S '' -- -h --help ;;
  esac
}

_kswapd_summary_sh "$@"
