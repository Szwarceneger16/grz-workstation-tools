#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Yubico Authenticator
GenericName=Yubico Authenticator
Exec=/bin/sh -c "cd && if test -x .local/share/yubico-authenticator/current/authenticator; then exec .local/bin/yubico-auth run --hidden; fi"
Icon=com.yubico.yubioath
Type=Application
Categories=Utility;
Keywords=Yubico;Authenticator;
Hidden=false
