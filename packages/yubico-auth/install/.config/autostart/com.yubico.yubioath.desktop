#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Yubico Authenticator
GenericName=Yubico Authenticator
Exec=/bin/sh -c "test -x \\$HOME/.local/share/yubico-authenticator/current/authenticator && exec \\$HOME/.local/bin/yubico-auth run --hidden"
Icon=com.yubico.yubioath
Type=Application
Categories=Utility;
Keywords=Yubico;Authenticator;
Hidden=false
