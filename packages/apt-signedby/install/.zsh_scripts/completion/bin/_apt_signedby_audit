#compdef apt-signedby-audit

# Zsh completion for apt-signedby-audit
# Bin: ~/.local/bin/apt-signedby-audit
# Target: ~/.zsh_scripts/completion/bin/_apt_signedby_audit

local curcontext="$curcontext" state line
local -a common_cooldowns

typeset -A opt_args

common_cooldowns=(
  '30:30 sekund'
  '60:1 minuta'
  '120:2 minuty (domyślnie)'
  '300:5 minut'
  '600:10 minut'
  '1800:30 minut'
  '3600:1 godzina'
)

_arguments -s -S \
  '(-h --help)'{-h,--help}'[pokaż pomoc i zakończ]' \
  '--notify[wyślij powiadomienie notify-send, gdy wykryto problem]' \
  '--popup[dodatkowo pokaż okno zenity, gdy wykryto problem]' \
  '--cooldown-secs=[minimalny odstęp między identycznymi alertami (sekundy)]:sekundy:_describe -t cooldowns "częste wartości" common_cooldowns || _guard "[0-9]#" "liczba całkowita (sekundy)"' \
  '--state-dir=[katalog stanu na hash/cooldown]:katalog:_files -/' \
  '*: :->args'

case $state in
  args)
    _message 'brak argumentów pozycyjnych'
    ;;
esac
