#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Type=Application
Name=MX DPI Wheel Configuration
Comment=Konfiguracja poziomow DPI dla MX DPI Wheel
Exec=/bin/sh -c "exec \\$HOME/.local/bin/mx_dpi_wheel.py --gui"
Icon=input-mouse
Terminal=false
Categories=Settings;
StartupNotify=true
NoDisplay=false
