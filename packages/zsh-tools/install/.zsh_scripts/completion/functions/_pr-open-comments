#compdef pr-open-comments pr-open-comments-copyq

_pr_open_comments_target_or_mode() {
  local -a prs modes

  modes=(
    'latest:aktualny branch PR, tylko najnowszy otwarty batch komentarzy'
    'all:aktualny branch PR, wszystkie otwarte komentarze'
  )

  _describe -t modes 'tryb dla PR-a aktualnego brancha' modes

  if command -v gh >/dev/null 2>&1; then
    prs=("${(@f)$(gh pr list --limit 20 --json number,title --jq '.[] | "\(.number):#\(.number) \(.title)"' 2>/dev/null)}")

    if (( ${#prs[@]} )); then
      _describe -t open-prs 'otwarte PR-y w tym repo albo wklej URL do PR' prs
      return
    fi
  fi

  _message -e pr-target 'enter: PR aktualnego brancha, albo wklej URL do PR / podaj nr'
}

_pr_open_comments_mode() {
  local -a modes

  modes=(
    'latest:tylko najnowszy otwarty batch komentarzy'
    'all:wszystkie otwarte komentarze'
  )

  _describe -t modes 'tryb pobierania komentarzy' modes
}

_pr_open_comments() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C -s -S \
    '(-h --help)'{-h,--help}'[pokaż pomoc]' \
    '1:PR URL, numer PR albo tryb dla aktualnego brancha:_pr_open_comments_target_or_mode' \
    '2:tryb pobierania komentarzy:_pr_open_comments_mode' \
    '*:: :->extra'

  case "$state" in
    extra)
      _message 'użycie: pr-open-comments [PR_URL|PR_NUMBER] [latest|all]'
      ;;
  esac
}

_pr_open_comments "$@"
