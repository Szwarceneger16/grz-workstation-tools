#compdef pnpm
###-begin-pnpm-completion-###
if type compdef &>/dev/null; then
  _pnpm_completion () {
    builtin emulate -L 'zsh'
    setopt noshwordsplit

    local -a reply
    local si=$IFS
    local _pnpm_bin

    # 1) Resolve the pnpm binary selected by the current PATH/tool manager.
    _pnpm_bin="$(builtin whence -p 'pnpm' 2>/dev/null)" || return 1
    [[ -f "$_pnpm_bin" && -x "$_pnpm_bin" ]] || return 1

    # 2) Ask the completion server for candidates.
    IFS=$'\n'
    reply=($(
      COMP_CWORD="$((CURRENT-1))" \
      COMP_LINE="$BUFFER" \
      COMP_POINT="$CURSOR" \
      SHELL=zsh \
      "$_pnpm_bin" completion-server -- "${words[@]}"
    ))
    IFS=$si

    # 2.6) Add short aliases for common subcommands to the server response.
    # Apply only when the current token starts with '-'.
    local _subcmd="${words[2]:-}"
    if [[ "${words[CURRENT]}" == -* && -n "$_subcmd" ]]; then
      # Normalize subcommand aliases.
      case "$_subcmd" in
        rm)        _subcmd=remove ;;
        up|upgrade) _subcmd=update ;;
        i)         _subcmd=install ;;
      esac

      local -a _short_flags
      case "$_subcmd" in
        add)
          # -D (--save-dev), -E (--save-exact), -P (--save-prod), -O (--save-optional)
          # plus common monorepo flags.
          _short_flags=(-D -E -P -O -g -w -r -F)
          ;;
        remove)
          _short_flags=(-g -w -r -F)
          ;;
        update)
          # -L (--latest), -i (--interactive), plus workspace flags.
          _short_flags=(-L -i -w -r -F)
          ;;
        install)
          # Workspace install: conservative flag set.
          _short_flags=(-w -r -F)
          ;;
      esac

      if (( ${#_short_flags[@]} )); then
        reply+=("${(@)_short_flags}")
        typeset -U reply   # remove duplicates
      fi
    fi

    # 3) Handle both possible file-completion markers.
    if [[ ${#reply[@]} -eq 1 && ( $reply[1] == "__tabtab_complete_files__" || $reply[1] == "_complete_files__" ) ]]; then
      _files
      return
    fi

    # 4) If empty, fall back to a static list of common commands.
    if [[ ${#reply[@]} -eq 0 ]]; then
      local -a fallback
      fallback=(
        add install i remove rm uninstall update up upgrade
        dlx run exec create init link unlink list ls why
        prune rebuild fetch install-test pack publish packlist
        outdated audit config env setup store import deploy
        ci dedupe migrate install-peers
      )
      compadd -a fallback
      return
    fi

    # 5) Return the normal server-provided listing when available.
    compadd -a reply
  }

  # Isolate dispatch too: with KSH_ARRAYS the caller's evaluation context and
  # array indexing cannot distinguish the first autoload call reliably.
  () {
    builtin emulate -L 'zsh'
    if [[ "${funcstack[2]:-}" == '_pnpm' ]]; then
      _pnpm_completion "$@"
    else
      compdef _pnpm_completion 'pnpm'
    fi
  } "$@"
fi
###-end-pnpm-completion-###
