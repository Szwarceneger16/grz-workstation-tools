#!/usr/bin/env bash
set -Eeuo pipefail

# netrole-apply-eth-labels
#
# Generuje sprzętowo-zależną część workflowu netrole z konfiguracji JSON i
# wdraża ją do systemu:
#   - /etc/systemd/network/09-<name>.link   (MAC -> stała nazwa interfejsu)
#   - /etc/udev/rules.d/99-netrole-usb-eth-labels.rules
#       (etykiety + odpalenie /usr/local/sbin/netrole-usb-eth-guard <name>)
# a następnie przeładowuje reguły udev.
#
# Źródłem prawdy jest ~/.config/simplified-netrole/config.json (ten sam plik,
# którego używa simplified_netrole). Każdy blok profilu z polami "mac" i
# "linkName" opisuje jeden fizyczny adapter USB-Ethernet, np.:
#
#   "NR_USBA0": {
#     "mac": "00:e0:4c:68:01:13",
#     "linkName": "nr-usba0",
#     "role": "USB-A",
#     ... (pola sieciowe używane przez netrole-netns-network)
#   }
#
# Realne MAC-i żyją tylko w tym lokalnym pliku — nigdy w repo. Guard jest
# generyczny i wersjonowany osobno (system-install), tu generujemy tylko to, co
# zawiera identyfikatory sprzętu.
#
# Wymaga uprawnień roota do zapisu w /etc. Uruchom po prostu:
#     netrole-apply-eth-labels
# skrypt sam poprosi o sudo dla operacji uprzywilejowanych. Dostępne tryby:
#     netrole-apply-eth-labels            # zastosuj i przeładuj udev
#     netrole-apply-eth-labels --print    # tylko wypisz co by zrobił (bez zmian)
#     netrole-apply-eth-labels --remove   # usuń wygenerowane pliki i przeładuj udev

PROG="${0##*/}"

GUARD_PATH="/usr/local/sbin/netrole-usb-eth-guard"
UDEV_RULE="/etc/udev/rules.d/99-netrole-usb-eth-labels.rules"
LINK_DIR="/etc/systemd/network"
LINK_PREFIX="09-"
LINK_MARKER="# netrole-apply-eth-labels: generated"
PLACEHOLDER_MAC="00:00:00:00:00:00"

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

mode="apply"
case "${1:-}" in
  --print) mode="print" ;;
  --remove) mode="remove" ;;
  --help|-h)
    sed -n '3,40p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  "") : ;;
  *) die "nieznany argument: $1 (dozwolone: --print, --remove, --help)" ;;
esac

# --- operacje uprzywilejowane -------------------------------------------------
priv() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  else
    sudo "$@"
  fi
}

reload_udev() {
  info "Przeładowuję reguły udev..."
  priv udevadm control --reload-rules || die "udevadm control --reload-rules nie powiodło się"
  priv udevadm trigger --subsystem-match=net --action=change >/dev/null 2>&1 || true
  if command -v networkctl >/dev/null 2>&1; then
    priv networkctl reload >/dev/null 2>&1 || true
  fi
}

# Usuwa wygenerowane przez nas pliki .link, których nazwa nie jest wśród
# argumentów (brak argumentów = usuń wszystkie). Rozpoznaje "nasze" pliki po
# markerze w treści, więc nigdy nie rusza .link-ów, których nie wygenerowaliśmy.
# Po usunięciu czegokolwiek ustawia globalną zmienną cleanup_removed=1.
cleanup_removed=0
cleanup_stale_links() {
  local keep=("$@")
  local file base match i
  shopt -s nullglob
  for file in "$LINK_DIR/${LINK_PREFIX}"*.link; do
    grep -qF "$LINK_MARKER" -- "$file" 2>/dev/null || continue
    base="$(basename "$file")"
    match=0
    for ((i = 0; i < ${#keep[@]}; i++)); do
      [[ "$base" == "${LINK_PREFIX}${keep[i]}.link" ]] && { match=1; break; }
    done
    if (( ! match )); then
      priv rm -f -- "$file" && { info "Usunięto nieaktualny $file"; cleanup_removed=1; }
    fi
  done
  shopt -u nullglob
}

# --- tryb --remove (best-effort: nie wymaga poprawnego/istniejącego configu) --
# Czyszczenie jest celowo niezależne od configu JSON (może być nieobecny lub
# mieć błędny wpis) — --remove ma po prostu sprzątnąć wszystko, co kiedykolwiek
# wygenerowaliśmy na dysku.
if [[ "$mode" == "remove" ]]; then
  removed=0
  if priv test -e "$UDEV_RULE"; then
    priv rm -f -- "$UDEV_RULE" && { info "Usunięto $UDEV_RULE"; removed=1; }
  fi
  cleanup_stale_links
  (( cleanup_removed )) && removed=1
  if (( removed )); then
    reload_udev
    info "Gotowe. Wygenerowane pliki netrole usunięte."
  else
    info "Nic do usunięcia."
  fi
  exit 0
fi

command -v python3 >/dev/null 2>&1 || die "python3 jest wymagany"

# --- ustalenie właściciela configu (spójne z simplified_netrole) --------------
config_owner_user() {
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER:-}" != "root" ]]; then
    printf '%s\n' "$SUDO_USER"
  else
    printf '%s\n' "${USER:-root}"
  fi
}

config_owner_home() {
  local user="$1" home
  home="$(getent passwd "$user" | awk -F: '{print $6}')"
  if [[ -n "$home" ]]; then
    printf '%s\n' "$home"
  elif [[ "$user" == "root" ]]; then
    printf '%s\n' "/root"
  else
    die "nie umiem ustalić HOME dla użytkownika: $user"
  fi
}

owner_user="$(config_owner_user)"
owner_home="$(config_owner_home "$owner_user")"
CONFIG_FILE="${NETROLE_CONFIG:-$owner_home/.config/simplified-netrole/config.json}"

[[ -e "$CONFIG_FILE" ]] || die "brak configu: $CONFIG_FILE (uruchom najpierw simplified_netrole, żeby go utworzyć, i wpisz realne MAC-i)"
[[ ! -L "$CONFIG_FILE" ]] || die "config jest symlinkiem — odmawiam czytania: $CONFIG_FILE"
[[ -r "$CONFIG_FILE" ]] || die "config nieczytelny: $CONFIG_FILE"

# --- wyciągnięcie adapterów z JSON: linkName \t mac \t role --------------------
# Każdy nieprawidłowy lub zduplikowany wpis jest błędem fatalnym (nie warningiem
# do pominięcia) — częściowo poprawny config nie powinien dawać wrażenia, że
# apply się w pełni powiodło.
adapters="$(python3 - "$CONFIG_FILE" "$PLACEHOLDER_MAC" <<'PYJSON'
import json, re, sys

path = sys.argv[1]
placeholder_mac = sys.argv[2].lower()
try:
    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as exc:
    sys.stderr.write("nie mogę sparsować JSON: %s\n" % exc)
    sys.exit(2)

if not isinstance(data, dict):
    sys.stderr.write("config nie jest obiektem JSON\n")
    sys.exit(2)

mac_re = re.compile(r"^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$")
# nr- (3 znaki) + do 12 znaków = max 15 = Linux IFNAMSIZ - 1
name_re = re.compile(r"^nr-[a-z0-9]{1,12}$")
# role trafia bez zmian do wartości pól udev — ogranicz znaki, żeby nie dało
# się nim wstrzyknąć cudzysłowu/nowej linii do wygenerowanej reguły.
role_re = re.compile(r"^[A-Za-z0-9_-]{1,32}$")

rows = []
errors = []
for key, val in data.items():
    if key.startswith("_") or not isinstance(val, dict):
        continue
    mac = val.get("mac")
    name = val.get("linkName")
    if mac is None and name is None:
        continue  # zwykły profil sieciowy bez opisu sprzętu
    role = val.get("role", "USB")
    if not name:
        errors.append("profil %s ma 'mac' bez 'linkName'" % key)
        continue
    if not isinstance(mac, str) or not mac_re.match(mac):
        errors.append("profil %s: nieprawidłowy MAC %r" % (key, mac))
        continue
    if not name_re.match(name):
        errors.append(
            "profil %s: linkName %r musi pasować do ^nr-[a-z0-9]{1,12}$ "
            "(limit 15 znaków — IFNAMSIZ)" % (key, name)
        )
        continue
    role = str(role)
    if not role_re.match(role):
        errors.append("profil %s: role %r musi pasować do ^[A-Za-z0-9_-]{1,32}$" % (key, role))
        continue
    rows.append((key, name, mac.lower(), role))

seen_names = {}
seen_macs = {}
for key, name, mac, role in rows:
    if name in seen_names:
        errors.append("linkName %r zduplikowany: profile %s i %s" % (name, seen_names[name], key))
    else:
        seen_names[name] = key
    # placeholderowy MAC jest oczekiwany w świeżo zaseedowanym configu (kilka
    # profili) — nie traktuj go jako duplikat, żeby --print dalej działało
    # jako podgląd; apply i tak odmówi dalej przez osobny check placeholdera.
    if mac == placeholder_mac:
        continue
    if mac in seen_macs:
        errors.append("mac %r zduplikowany: profile %s i %s" % (mac, seen_macs[mac], key))
    else:
        seen_macs[mac] = key

if errors:
    for e in errors:
        sys.stderr.write(e + "\n")
    sys.exit(1)

# stabilna, deterministyczna kolejność
for key, name, mac, role in sorted(rows, key=lambda r: r[1]):
    print("%s\t%s\t%s" % (name, mac, role))
PYJSON
)" || die "odczyt configu nie powiódł się (patrz komunikaty powyżej): $CONFIG_FILE"

# --- walidacja przed apply/print ----------------------------------------------
[[ -n "$adapters" ]] || die "config nie zawiera żadnego adaptera (pól 'mac'+'linkName'): $CONFIG_FILE"

# --- render reguły udev -------------------------------------------------------
render_udev_rule() {
  printf '# netrole USB Ethernet persistent labels and replug guard\n'
  printf '# WYGENEROWANE przez netrole-apply-eth-labels z %s — nie edytuj ręcznie.\n' "$CONFIG_FILE"
  while IFS=$'\t' read -r name mac role; do
    [[ -n "$name" ]] || continue
    printf '\n# %s labels: %s / %s\n' "$role" "$name" "$mac"
    printf 'SUBSYSTEM=="net", ACTION!="remove", ATTR{address}=="%s", ENV{ID_VENDOR}:="netrole", ENV{ID_VENDOR_FROM_DATABASE}:="netrole", ENV{ID_MODEL}:="%s ETH %s", ENV{ID_MODEL_FROM_DATABASE}:="netrole %s ETH %s"\n' "$mac" "$role" "$name" "$role" "$name"
    printf 'SUBSYSTEM=="net", ACTION!="remove", KERNEL=="%s", ENV{ID_VENDOR}:="netrole", ENV{ID_VENDOR_FROM_DATABASE}:="netrole", ENV{ID_MODEL}:="%s ETH %s", ENV{ID_MODEL_FROM_DATABASE}:="netrole %s ETH %s"\n' "$name" "$role" "$name" "$role" "$name"
  done <<< "$adapters"
  printf '\n# Run delayed guard after physical hotplug.\n'
  while IFS=$'\t' read -r name mac role; do
    [[ -n "$name" ]] || continue
    printf 'SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="%s", RUN+="/usr/bin/systemd-run --no-block --collect %s %s"\n' "$mac" "$GUARD_PATH" "$name"
  done <<< "$adapters"
}

render_link() {
  local mac="$1" name="$2"
  printf '%s\n[Match]\nMACAddress=%s\n\n[Link]\nName=%s\n' "$LINK_MARKER" "$mac" "$name"
}

# --- tryb --print -------------------------------------------------------------
if [[ "$mode" == "print" ]]; then
  info "==> $UDEV_RULE"
  render_udev_rule
  while IFS=$'\t' read -r name mac role; do
    [[ -n "$name" ]] || continue
    info ""
    info "==> $LINK_DIR/${LINK_PREFIX}${name}.link"
    render_link "$mac" "$name"
  done <<< "$adapters"
  exit 0
fi

# --- tryb apply ---------------------------------------------------------------
if grep -q "$PLACEHOLDER_MAC" <<< "$adapters"; then
  die "config zawiera placeholderowy MAC ($PLACEHOLDER_MAC) — wpisz realne adresy w $CONFIG_FILE"
fi

[[ -x "$GUARD_PATH" ]] || die "guard nie jest zainstalowany/wykonywalny: $GUARD_PATH (uruchom najpierw: ./run.sh install simplified_netrole)"

info "Instaluję etykiety/guard netrole z $CONFIG_FILE"

tmp="$(mktemp)"
trap 'rm -f -- "$tmp"' EXIT

render_udev_rule > "$tmp"
priv install -D -m 0644 -o root -g root -- "$tmp" "$UDEV_RULE"
info "Zapisano $UDEV_RULE"

names=()
while IFS=$'\t' read -r name mac role; do
  [[ -n "$name" ]] || continue
  names+=("$name")
  link="$LINK_DIR/${LINK_PREFIX}${name}.link"
  render_link "$mac" "$name" > "$tmp"
  priv install -D -m 0644 -o root -g root -- "$tmp" "$link"
  info "Zapisano $link ($mac -> $name)"
done <<< "$adapters"

# Sprzątnij .link-i wygenerowane wcześniej dla MAC-ów, którym w międzyczasie
# zmieniono linkName — inaczej stary plik zostaje na dysku i konfiguracja nie
# zbiega się do stanu z configu.
cleanup_stale_links "${names[@]}"

reload_udev
info "Gotowe. Podłącz ponownie adapter, żeby zastosować nazwę i guard (patrz: journalctl -t netrole-usb-eth-guard)."
