#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "Użycie:"
  echo "  $0 PROFILE_NAME IFACE [URL...]"
  echo
  echo "Przykład:"
  echo "  $0 usbwan-1 eth0"
  echo "  $0 usbwan-1 eth0 http://192.168.10.1/ http://192.168.10.3/"
  exit 1
fi

PROFILE_NAME="${1:?}"
IFACE="${2:?}"

shift 2

OPEN_URLS=("$@")

if [ ! -e "/sys/class/net/$IFACE/address" ]; then
  echo "Nie widzę interfejsu: $IFACE"
  echo
  echo "Dostępne interfejsy:"
  ls /sys/class/net
  exit 2
fi

MAC="$(cat "/sys/class/net/$IFACE/address")"
SAFE_MAC="${MAC//:/-}"

DISPLAY_IFACE="${NETROLE_FIREFOX_DISPLAY_IFACE:-$IFACE}"

SAFE_PROFILE_NAME="$(printf '%s' "$PROFILE_NAME" | tr -c '[:alnum:]_.-' '-')"
SAFE_DISPLAY_IFACE="$(printf '%s' "$DISPLAY_IFACE" | tr -c '[:alnum:]_.-' '-')"

LABEL="${SAFE_PROFILE_NAME}-${SAFE_DISPLAY_IFACE}-${SAFE_MAC}"
WINDOW_CLASS="netrole-${LABEL}"
WINDOW_TITLE="netrole: ${PROFILE_NAME} | ${DISPLAY_IFACE} | ${MAC}"

BASE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/netrole-firefox"
PROFILE_DIR="${NETROLE_FIREFOX_PROFILE_DIR:-$BASE_DIR/profiles/$LABEL}"
PAGE_DIR="$BASE_DIR/pages/$LABEL"
START_PAGE="$PAGE_DIR/start.html"

mkdir -p "$PROFILE_DIR" "$PAGE_DIR"
chmod 0700 "$PROFILE_DIR"

html_escape() {
  printf '%s' "$1" \
    | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

E_WINDOW_TITLE="$(html_escape "$WINDOW_TITLE")"
E_PROFILE_NAME="$(html_escape "$PROFILE_NAME")"
E_DISPLAY_IFACE="$(html_escape "$DISPLAY_IFACE")"
E_IFACE="$(html_escape "$IFACE")"
E_MAC="$(html_escape "$MAC")"
E_WINDOW_CLASS="$(html_escape "$WINDOW_CLASS")"

{
  cat <<HTML
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>${E_WINDOW_TITLE}</title>
</head>
<body style="font-family: sans-serif; padding: 2rem; line-height: 1.45;">
  <h1>${E_WINDOW_TITLE}</h1>

  <table style="border-collapse: collapse;">
    <tr>
      <td style="padding: .35rem 1rem .35rem 0;"><b>Profile</b></td>
      <td>${E_PROFILE_NAME}</td>
    </tr>
    <tr>
      <td style="padding: .35rem 1rem .35rem 0;"><b>Interface</b></td>
      <td>${E_DISPLAY_IFACE}</td>
    </tr>
    <tr>
      <td style="padding: .35rem 1rem .35rem 0;"><b>Runtime iface</b></td>
      <td>${E_IFACE}</td>
    </tr>
    <tr>
      <td style="padding: .35rem 1rem .35rem 0;"><b>MAC</b></td>
      <td>${E_MAC}</td>
    </tr>
    <tr>
      <td style="padding: .35rem 1rem .35rem 0;"><b>WM_CLASS</b></td>
      <td>${E_WINDOW_CLASS}</td>
    </tr>
  </table>

  <h2 style="margin-top: 2rem;">Open URLs</h2>
HTML

  if [ "${#OPEN_URLS[@]}" -gt 0 ]; then
    echo '  <ul>'
    for open_url in "${OPEN_URLS[@]}"; do
      e_url="$(html_escape "$open_url")"
      printf '    <li><a href="%s">%s</a></li>\n' "$e_url" "$e_url"
    done
    echo '  </ul>'
  else
    echo '  <p>brak</p>'
  fi

  cat <<'HTML'

  <p style="margin-top: 2rem;">
    This tab identifies the netrole test browser window.
  </p>
</body>
</html>
HTML
} > "$START_PAGE"

cat > "$PROFILE_DIR/user.js" <<'EOF_USERJS'
/*
 * netrole Firefox test profile
 * Cel: zero first-run noise, zero session restore, zero telemetry,
 * zero agresywnych warstw prywatnościowych, możliwie neutralny browser
 * do testów sieci/DNS/NetworkManager.
 */

/* Startup / first-run / welcome screens */
user_pref("browser.startup.page", 0);
user_pref("browser.startup.homepage", "about:blank");
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.startup.homepage_override.buildID", "ignore");
user_pref("browser.startup.homepage_override.once", "");
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.shell.skipDefaultBrowserCheckOnFirstRun", true);
user_pref("startup.homepage_welcome_url", "");
user_pref("startup.homepage_welcome_url.additional", "");
user_pref("trailhead.firstrun.didSeeAboutWelcome", true);
user_pref("browser.startup.upgradeDialog.enabled", false);

/* Session restore / crash restore */
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_resumed_crashes", 0);
user_pref("browser.sessionstore.restore_on_demand", false);
user_pref("browser.sessionstore.restore_tabs_lazily", false);
user_pref("browser.sessionstore.warnOnQuit", false);
user_pref("browser.warnOnQuit", false);
user_pref("browser.tabs.warnOnClose", false);

// netrole lab: do not auto-upgrade local device panels to HTTPS
user_pref("dom.security.https_only_mode", false);
user_pref("dom.security.https_only_mode_pbm", false);
user_pref("dom.security.https_only_mode_ever_enabled", false);
user_pref("dom.security.https_first", false);
user_pref("dom.security.https_first_schemeless", false);

// netrole lab: make certificate warning page less annoying
user_pref("browser.xul.error_pages.expert_bad_cert", true);
user_pref("security.certerrors.permanentOverride", true);

/* New tab noise */
user_pref("browser.newtabpage.enabled", false);
user_pref("browser.newtabpage.activity-stream.enabled", false);
user_pref("browser.newtabpage.activity-stream.feeds.topsites", false);
user_pref("browser.newtabpage.activity-stream.feeds.section.topstories", false);
user_pref("browser.newtabpage.activity-stream.showSponsored", false);
user_pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);
user_pref("browser.newtabpage.activity-stream.default.sites", "");

/* Telemetry / data reporting */
user_pref("datareporting.policy.firstRunURL", "");
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("toolkit.telemetry.enabled", false);
user_pref("toolkit.telemetry.unified", false);
user_pref("toolkit.telemetry.archive.enabled", false);
user_pref("toolkit.telemetry.server", "data:,");
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("toolkit.telemetry.newProfilePing.enabled", false);
user_pref("toolkit.telemetry.shutdownPingSender.enabled", false);
user_pref("toolkit.telemetry.updatePing.enabled", false);
user_pref("toolkit.telemetry.bhrPing.enabled", false);
user_pref("toolkit.telemetry.firstShutdownPing.enabled", false);
user_pref("browser.ping-centre.telemetry", false);

/* Experiments / studies / remote feature rollout */
user_pref("app.normandy.enabled", false);
user_pref("app.normandy.first_run", false);
user_pref("app.normandy.api_url", "");
user_pref("app.shield.optoutstudies.enabled", false);

/* Crash reporting */
user_pref("browser.crashReports.unsubmittedCheck.enabled", false);
user_pref("browser.crashReports.unsubmittedCheck.autoSubmit", false);
user_pref("browser.crashReports.unsubmittedCheck.autoSubmit2", false);
user_pref("breakpad.reportURL", "");

/* Tracking protection / content blocking disabled for neutral network tests */
user_pref("browser.contentblocking.category", "standard");
user_pref("privacy.trackingprotection.enabled", false);
user_pref("privacy.trackingprotection.pbmode.enabled", false);
user_pref("privacy.trackingprotection.emailtracking.enabled", false);
user_pref("privacy.trackingprotection.socialtracking.enabled", false);
user_pref("privacy.annotate_channels.strict_list.enabled", false);
user_pref("privacy.donottrackheader.enabled", false);
user_pref("privacy.globalprivacycontrol.enabled", false);
user_pref("privacy.resistFingerprinting", false);
user_pref("privacy.firstparty.isolate", false);

/* HTTPS-only / mixed network behavior — pełny zestaw ustawiony wyżej, przy "netrole lab" */

/* DNS/proxy: use system network stack, no Firefox DoH/TRR */
user_pref("network.trr.mode", 5);
user_pref("network.trr.uri", "");
user_pref("network.proxy.type", 0);

/* Background Mozilla connectivity probes */
user_pref("network.captive-portal-service.enabled", false);
user_pref("network.connectivity-service.enabled", false);

/* SafeBrowsing remote checks disabled for isolated lab profiles */
user_pref("browser.safebrowsing.malware.enabled", false);
user_pref("browser.safebrowsing.phishing.enabled", false);
user_pref("browser.safebrowsing.blockedURIs.enabled", false);
user_pref("browser.safebrowsing.downloads.enabled", false);
user_pref("browser.safebrowsing.downloads.remote.enabled", false);

/* Suggestions / promos / account noise */
user_pref("browser.urlbar.quicksuggest.enabled", false);
user_pref("browser.urlbar.suggest.quicksuggest.nonsponsored", false);
user_pref("browser.urlbar.suggest.quicksuggest.sponsored", false);
user_pref("browser.search.suggest.enabled", false);
user_pref("browser.messaging-system.whatsNewPanel.enabled", false);
user_pref("extensions.pocket.enabled", false);
user_pref("identity.fxaccounts.enabled", false);
EOF_USERJS

rm -f \
  "$PROFILE_DIR/sessionstore.jsonlz4" \
  "$PROFILE_DIR/sessionCheckpoints.json" \
  "$PROFILE_DIR/sessionstore-backups/recovery.jsonlz4" \
  "$PROFILE_DIR/sessionstore-backups/recovery.baklz4" \
  "$PROFILE_DIR/sessionstore-backups/previous.jsonlz4" \
  "$PROFILE_DIR/sessionstore-backups/upgrade.jsonlz4-"*

mkdir -p "$PROFILE_DIR/sessionstore-backups"

FIREFOX_BIN="${NETROLE_FIREFOX_BIN:-${FIREFOX_BIN:-$(command -v firefox || true)}}"

if [ -z "$FIREFOX_BIN" ] || [ ! -x "$FIREFOX_BIN" ]; then
  echo "Nie znaleziono wykonywalnego Firefoksa."
  echo "FIREFOX_BIN=$FIREFOX_BIN"
  exit 3
fi

FIREFOX_ARGS=(
  --new-instance
  --no-remote
  --class "$WINDOW_CLASS"
  --profile "$PROFILE_DIR"
  "file://$START_PAGE"
)

if [ "${#OPEN_URLS[@]}" -gt 0 ]; then
  FIREFOX_ARGS+=("${OPEN_URLS[@]}")
fi

"$FIREFOX_BIN" "${FIREFOX_ARGS[@]}" &
FIREFOX_PID=$!

# Czekamy do 3 sekund — jeśli Firefox zakończy się przed upływem czasu,
# zbieramy jego kod wyjścia i wykrywamy błąd startu.
# Jeśli żyje po 3s, uznajemy start za udany i kontynuujemy.
_firefox_start_ok=1
for _i in 1 2 3; do
  sleep 1
  if ! kill -0 "$FIREFOX_PID" 2>/dev/null; then
    # Proces już nie istnieje — zbierz kod wyjścia
    wait "$FIREFOX_PID" 2>/dev/null || true
    _firefox_start_ok=0
    break
  fi
done
unset _i

if [ "$_firefox_start_ok" -eq 0 ]; then
  echo "[BŁĄD] Firefox zakończył się natychmiast po starcie (PID $FIREFOX_PID)." >&2
  echo "       Sprawdź profil lub plik binarny: $FIREFOX_BIN" >&2
  exit 4
fi
unset _firefox_start_ok

echo "Uruchomiono Firefox (PID $FIREFOX_PID):"
echo "  profile name: $PROFILE_NAME"
echo "  iface:        $IFACE"
echo "  display iface: $DISPLAY_IFACE"
echo "  mac:          $MAC"
echo "  class:        $WINDOW_CLASS"
echo "  profile dir:  $PROFILE_DIR"
echo "  start page:   $START_PAGE"

if [ "${#OPEN_URLS[@]}" -gt 0 ]; then
  echo "  open URLs:"
  printf '    - %s\n' "${OPEN_URLS[@]}"
else
  echo "  open URLs:    brak"
fi
