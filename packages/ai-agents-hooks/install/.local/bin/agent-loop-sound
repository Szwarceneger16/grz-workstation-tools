#!/usr/bin/env bash
set -euo pipefail

agent="${1:?agent name required}"
sound="${2:?sound path required}"

# Priorytet:
# 1. AGENT_SOUND_DURATION_SECONDS
# 2. trzeci argument
# 3. 15 sekund
duration="${AGENT_SOUND_DURATION_SECONDS:-${3:-15}}"

# Apply one shared temporary mixing factor, never saved application volume.
duck_percent="${AGENT_DUCK_PERCENT:-80}"
script_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
duck_helper="${script_dir}/../lib/agent-loop-sounds/ducking.py"

# 100 = nasz dźwięk agenta wymuszamy na 100%.
agent_volume_percent="${AGENT_SOUND_VOLUME_PERCENT:-100}"

if ! command -v pw-play >/dev/null 2>&1; then
  printf 'pw-play not found\n' >&2
  exit 1
fi

if [ ! -f "$sound" ]; then
  printf 'sound file not found: %s\n' "$sound" >&2
  exit 1
fi

case "$duration" in
  ''|*[!0-9.]*)
    printf 'invalid duration: %s\n' "$duration" >&2
    exit 1
    ;;
esac

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-loop-sounds"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/agent-loop-sounds"

mkdir -p "$cache_dir" "$runtime_dir"

safe_agent="$(printf '%s' "$agent" | tr -cd '[:alnum:]_-')"

cache_key="$(
  python3 - "$sound" "$duration" <<'PY'
import hashlib
import os
import sys

path, duration = sys.argv[1:3]

h = hashlib.sha256()
h.update(os.path.abspath(path).encode())
h.update(b"\0")
h.update(duration.encode())
h.update(b"\0")

st = os.stat(path)
h.update(str(st.st_size).encode())
h.update(b"\0")
h.update(str(st.st_mtime_ns).encode())

print(h.hexdigest()[:24])
PY
)"

loop_sound="${cache_dir}/${safe_agent}-${cache_key}-${duration}s.wav"

stop_file="$(mktemp "${runtime_dir}/${safe_agent}.stop.XXXXXX")"
signal_id="$(basename -- "$stop_file")"

rm -f "$stop_file"

player_pid=""
notify_pid=""
duck_monitor_pid=""
cleanup() {
  if [ -n "${duck_monitor_pid:-}" ]; then
    kill "$duck_monitor_pid" >/dev/null 2>&1 || true
    wait "$duck_monitor_pid" 2>/dev/null || true
  fi

  if [ -n "${player_pid:-}" ]; then
    kill "$player_pid" >/dev/null 2>&1 || true
    wait "$player_pid" 2>/dev/null || true
  fi

  if [ -n "${notify_pid:-}" ]; then
    kill "$notify_pid" >/dev/null 2>&1 || true
    wait "$notify_pid" 2>/dev/null || true
  fi

  rm -f "$stop_file"
}

trap cleanup EXIT INT TERM

# Cache: generuj tylko gdy brakuje gotowego loopa.
# Plik wynikowy ma dokładnie duration sekund:
# original -> reversed -> original -> reversed...
if [ ! -f "$loop_sound" ]; then
  tmp_loop="${loop_sound}.tmp.$$"

  python3 - "$sound" "$tmp_loop" "$duration" <<'PY'
import os
import sys
import wave

src, dst, duration_s = sys.argv[1], sys.argv[2], float(sys.argv[3])

if duration_s <= 0:
    raise SystemExit("duration must be positive")

with wave.open(src, "rb") as r:
    params = r.getparams()
    frames = r.readframes(r.getnframes())

frame_size = params.nchannels * params.sampwidth
source_frame_count = len(frames) // frame_size

if source_frame_count <= 0:
    raise SystemExit("empty wav")

reversed_frames = b"".join(
    frames[i:i + frame_size]
    for i in range(len(frames) - frame_size, -1, -frame_size)
)

target_frames = int(round(params.framerate * duration_s))
target_bytes = target_frames * frame_size

chunks = [frames, reversed_frames]
out = bytearray()
idx = 0

while len(out) < target_bytes:
    out.extend(chunks[idx % 2])
    idx += 1

out = out[:target_bytes]

with wave.open(dst, "wb") as w:
    w.setparams(params)
    w.writeframes(bytes(out))

os.replace(dst, sys.argv[2])
PY

  mv -f "$tmp_loop" "$loop_sound" 2>/dev/null || true
fi

# Identify this invocation by its private stream tag or exact player PID.
# Native PipeWire streams may omit the PID from the Pulse-compatible view.
set_agent_volume() {
  command -v pactl >/dev/null 2>&1 || return 0

  python3 - "$player_pid" "$agent_volume_percent" "$signal_id" <<'PYCODE'
import json
import subprocess
import sys

player_pid, requested, signal_id = sys.argv[1:4]
try:
    volume = max(1, min(150, int(requested)))
except ValueError:
    volume = 100

try:
    result = subprocess.run(
        ["pactl", "--format=json", "list", "sink-inputs"],
        capture_output=True, text=True, timeout=1, check=True,
    )
    for stream in json.loads(result.stdout):
        props = stream.get("properties", {})
        if (str(props.get("application.process.id", "")) != player_pid
                and props.get("agent.loop-sound.id") != signal_id):
            continue
        result = subprocess.run(
            ["pactl", "set-sink-input-volume", str(int(stream["index"])), f"{volume}%"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1,
        )
        sys.exit(0 if result.returncode == 0 else 1)
except (OSError, ValueError, TypeError, KeyError, AttributeError, subprocess.SubprocessError):
    pass
sys.exit(1)
PYCODE
}

expire_ms="$(
  python3 - "$duration" <<'PY'
import sys
print(int(round(float(sys.argv[1]) * 1000)))
PY
)"

(
  if notify-send --help 2>&1 | grep -q -- '--action'; then
    action="$(
      notify-send \
        --app-name="$agent" \
        --icon=audio-speakers \
        --urgency=critical \
        --expire-time="$expire_ms" \
        --action=stop=Stop \
        --wait \
        "$agent skończył zadanie" \
        "Gram dźwięk zakończenia. Kliknij Stop, żeby uciszyć." \
        2>/dev/null || true
    )"

    if [ "$action" = "stop" ]; then
      : > "$stop_file"
    fi
  else
    notify-send \
      --app-name="$agent" \
      --icon=audio-speakers \
      --urgency=critical \
      --expire-time="$expire_ms" \
      "$agent skończył zadanie" \
      "Gram dźwięk zakończenia." \
      >/dev/null 2>&1 || true
  fi
) &
notify_pid="$!"

pw-play --media-role Notification --properties "{ application.name = \"agent-loop-sound\" agent.loop-sound.id = \"$signal_id\" state.restore-props = false }" "$loop_sound" >/dev/null 2>&1 &
player_pid="$!"

# Set this signal's own stream volume once. The shared coordinator below
# manages temporary software mixing without changing other application sliders.
for _ in $(seq 1 30); do
  kill -0 "$player_pid" >/dev/null 2>&1 || break
  [ -e "$stop_file" ] && break
  if set_agent_volume; then
    break
  fi
  sleep 0.05
done

if command -v pw-dump >/dev/null 2>&1 && command -v pw-cli >/dev/null 2>&1; then
  python3 "$duck_helper" "$runtime_dir" "$$" "$player_pid" "$duck_percent" &
  duck_monitor_pid="$!"
fi

while kill -0 "$player_pid" >/dev/null 2>&1; do
  if [ -e "$stop_file" ]; then
    kill "$player_pid" >/dev/null 2>&1 || true
    wait "$player_pid" 2>/dev/null || true
    break
  fi
  sleep 0.1
done

wait "$player_pid" 2>/dev/null || true
player_pid=""
