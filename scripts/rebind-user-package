#!/usr/bin/env python3
"""Explicit user-link handoff for one package or all-user. No hooks/system actions."""
import argparse
from contextlib import ExitStack, contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import uuid


class Refusal(Exception):
    pass


class Interrupted(Refusal):
    """An explicit interruption stops the batch after the current rollback."""


def require(ok, message):
    if not ok:
        raise Refusal(message)


@contextmanager
def mutation_record():
    # A handled signal must not land between a filesystem mutation and recording
    # its rollback ownership. Linux-only helper, like the workstation runner.
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})
    try:
        yield
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)


def identity(path):
    try:
        s = path.lstat()
        return (s.st_dev, s.st_ino, s.st_mode, s.st_mtime_ns, s.st_size)
    except FileNotFoundError:
        return None


def directories(path, missing=False):
    for part in reversed((path, *path.parents)):
        entry = identity(part)
        if entry is None and missing:
            continue
        require(entry is not None and stat.S_ISDIR(entry[2]), f"unsafe directory: {part}")


def absolute(value, missing=False):
    p = Path(value)
    require(p.is_absolute() and not value.startswith('//') and str(p) == value and '..' not in p.parts and
            not any(ord(c) < 32 or ord(c) == 127 for c in value), 'expected normalized absolute path')
    require(p != Path('/'), 'filesystem root is not a valid installation target')
    directories(p, missing=missing)
    return p


def relative(value):
    require(re.fullmatch(r'[A-Za-z0-9_./+@-]+', value) and
            all(p not in {'', '.', '..', '.git'} for p in value.split('/')),
            'unsafe package-relative path')
    require(value.startswith(('.config/', '.local/', '.zsh_scripts/')),
            'rebind only supports explicit user configuration paths')
    return value


IGNORES = (
    r'(^|/)\.git(/|$)', r'(^|/)\.gitignore$', r'(^|/)\.gitattributes$',
    r'(^|/)\.gitmodules$', r'(^|/)\.gitkeep$', r'(^|/)\.stow-local-ignore$',
    r'(^|/)(__pycache__|\.pytest_cache|\.mypy_cache|\.ruff_cache|\.tox|\.nox)(/|$)',
    r'\.py[co]$', r'(^|/)\.DS_Store$', r'(^|/)Thumbs\.db$', r'~$', r'\.sw[opx]$',
    r'(^|/)\.#', r'(^|/)#.*#$',
)


def unreadable_tree(error):
    raise Refusal('cannot enumerate the complete package tree') from error


def inventory(repo, package):
    source = repo / 'packages' / package / 'install'
    directories(source)
    directories(repo / 'stow')
    link = repo / 'stow' / package
    require(link.is_symlink() and os.readlink(link) == f'../packages/{package}/install',
            f'invalid Stow package mapping: {link}')
    records = {}
    for directory, dirs, files in os.walk(source, followlinks=False, onerror=unreadable_tree):
        for name in sorted(dirs + files):
            p = Path(directory) / name
            rel = p.relative_to(source).as_posix()
            require(name != '.stow-local-ignore', 'custom Stow ignore policy is not supported by rebind')
            if any(re.search(pattern, rel) for pattern in IGNORES):
                if name in dirs:
                    dirs.remove(name)
                continue
            s = p.lstat()
            require(stat.S_ISREG(s.st_mode) or stat.S_ISDIR(s.st_mode), f'non-regular package entry: {rel}')
            relative(rel + '/entry' if p.is_dir() else rel)
            if stat.S_ISREG(s.st_mode):
                records[rel] = (identity(p), hashlib.sha256(p.read_bytes()).hexdigest())
    require(records, f'empty user package: {package}')
    return records


def mappings(repo, package, files):
    path = repo / 'packages' / package / 'rebind-paths.manifest'
    if identity(path) is None:
        return {}, None
    require(stat.S_ISREG(path.lstat().st_mode), 'rename manifest must be a regular file')
    raw = path.read_bytes()
    result = {}
    for line in raw.decode('utf-8').splitlines():
        if not line.strip() or line.startswith('#'):
            continue
        fields = line.split()
        require(len(fields) == 2, 'rename record must contain old-path new-path')
        old, new = map(relative, fields)
        require(old not in result and new not in result.values() and old not in files and new in files,
                'duplicate, ambiguous or unsupported rename')
        result[old] = new
    return result, (identity(path), hashlib.sha256(raw).hexdigest())


def lost_source_state(roots):
    """Bind explicitly missing roots and their non-symlink ancestors to approval."""
    state = {}
    for root in roots:
        directories(root, missing=True)
        require(identity(root) is None, f'recovery source checkout must be absent: {root}')
        state[str(root)] = {str(p): entry[:3] if (entry := identity(p)) else None
                            for p in (root, *root.parents)}
    return state


def refresh_plan(repo, target, package, roots, snapshot):
    modes = {key: True for key in ('recover_dangling', 'force_links') if snapshot.get(key)}
    return plan(repo, target, package, roots, **modes)


def source_unchanged(fresh, snapshot):
    keys = ('files', 'legacy', 'mapping', 'renames')
    return all(fresh[key] == snapshot[key] for key in keys) and (
        fresh.get('lost_sources') == snapshot.get('lost_sources') and
        fresh.get('force_links') == snapshot.get('force_links'))


def plan(repo, target, package, roots, recover_dangling=False, force_links=False):
    directories(target)
    files = inventory(repo, package)
    renames, mapping_state = mappings(repo, package, files)
    lost_sources = lost_source_state(roots) if recover_dangling else None
    legacy = {str(root): {} if recover_dangling else inventory(root, package) for root in roots}
    rows = []
    parents = {}
    conflicts = []
    renamed_changes = {}
    for rel in sorted(set(files) | set(renames) | {p for values in legacy.values() for p in values}):
        dest = target / rel
        directories(dest.parent, missing=True)
        for parent in (target, *dest.parents):
            if parent != target and not parent.is_relative_to(target):
                continue
            entry = identity(parent)
            parents[str(parent)] = entry[:3] if entry else None
        before = identity(dest)
        raw = os.readlink(dest) if before and stat.S_ISLNK(before[2]) else None
        resolved = None
        source = repo / 'packages' / package / 'install' / rel
        allowed = {source, repo / 'stow' / package / rel}
        for root in roots:
            if rel in legacy[str(root)]:
                allowed.update({root / 'stow' / package / rel,
                                root / 'packages' / package / 'install' / rel})
        # Never resolve an arbitrary foreign chain outside the known package layouts.
        if raw is not None and Path(os.path.abspath(dest.parent / raw)) in allowed:
            try:
                resolved = dest.resolve(strict=True)
            except (OSError, RuntimeError):
                pass
        owner = None
        if resolved is not None:
            for root in roots:
                if rel in legacy[str(root)] and resolved == root / 'packages' / package / 'install' / rel:
                    # Only a direct reference to the approved layout, not an arbitrary symlink chain.
                    lexical = Path(os.path.abspath(dest.parent / raw))
                    allowed = {root / 'stow' / package / rel, root / 'packages' / package / 'install' / rel}
                    if lexical in allowed:
                        owner = str(root)
        lost_owner = None
        if recover_dangling and raw is not None and rel in files:
            for root in roots:
                sources = {root / 'stow' / package / rel,
                           root / 'packages' / package / 'install' / rel}
                # With no old tree, do not resolve a chain to prove ownership.
                # Accept canonical direct text only, avoiding interior '..'
                # components that could traverse an unrelated symlink first.
                if raw in {text for source in sources for text in (
                        str(source), os.path.relpath(source, dest.parent))}:
                    lost_owner = str(root)
        if before is None:
            state = 'missing' if rel in files else 'absent-legacy'
        elif resolved == source and rel in files and raw is not None and Path(os.path.abspath(dest.parent / raw)) in {
                source, repo / 'stow' / package / rel}:
            state = 'current'
        elif lost_owner:
            state = 'recover-dangling'
        elif owner:
            state = 'rebind' if rel in files else 'rename' if rel in renames else 'legacy-residue'
        elif force_links and raw is not None and rel in files:
            require(not any(ord(c) < 32 or ord(c) == 127 for c in raw),
                    f'unsafe link text at declared destination: {rel}')
            state = 'force-link'
        else:
            state = 'conflict'
        if state in {'legacy-residue', 'conflict'}:
            conflicts.append(rel)
        new = os.path.relpath(repo / 'stow' / package / rel, dest.parent) if rel in files else None
        changed = owner is not None and rel in files and (
            files[rel][1] != legacy[owner][rel][1] or
            stat.S_IMODE(files[rel][0][2]) != stat.S_IMODE(legacy[owner][rel][0][2]))
        if state == 'rename':
            replacement = files[renames[rel]]
            original = legacy[owner][rel]
            renamed_changes[renames[rel]] = (replacement[1] != original[1] or
                stat.S_IMODE(replacement[0][2]) != stat.S_IMODE(original[0][2]))
        rows.append({'path': rel, 'state': state, 'before': before, 'old': raw, 'new': new,
                     'content_changed': changed, 'from_repo': owner or lost_owner})
    for row in rows:
        row['content_changed'] |= renamed_changes.get(row['path'], False)
    result = {'files': files, 'legacy': legacy, 'mapping': mapping_state, 'renames': renames, 'parents': parents,
              'rows': rows, 'conflicts': conflicts}
    if recover_dangling:
        result.update(recover_dangling=True, lost_sources=lost_sources)
    if force_links:
        result['force_links'] = True
    return result


def discover_sources(repo, target, package):
    """Inspect exact declared destinations, never enumerate target directories."""
    directories(target)
    files = inventory(repo, package)
    renames, _ = mappings(repo, package, files)
    roots = set()
    for rel in sorted(set(files) | set(renames)):
        dest = target / rel
        directories(dest.parent, missing=True)
        entry = identity(dest)
        if entry is None or not stat.S_ISLNK(entry[2]):
            continue
        raw = os.readlink(dest)
        require(not any(ord(c) < 32 or ord(c) == 127 for c in raw),
                f'unsafe link text at declared destination: {rel}')
        lexical = Path(os.path.abspath(dest.parent / raw))
        for suffix in (Path('stow') / package / rel,
                       Path('packages') / package / 'install' / rel):
            count = len(suffix.parts)
            if lexical.parts[-count:] != suffix.parts:
                continue
            root = absolute(str(lexical.parents[count - 1]))
            if root != repo:
                roots.add(root)
    return sorted(roots)


def prepare(repo, target, package, explicit_roots, recover_dangling=False, force_links=False):
    require(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', package) and
            package not in {'all', 'all-user', 'all-system'}, 'select exactly one explicit package')
    require(not recover_dangling or explicit_roots,
            '--recover-dangling requires explicit --from-repo values')
    require(not force_links or explicit_roots,
            '--force-links requires explicit --from-repo values')
    roots = explicit_roots if explicit_roots else discover_sources(repo, target, package)
    require(len(set(roots)) == len(roots) and repo not in roots,
            'supply distinct source checkouts, never the current checkout')
    require(not any(target == r or target.is_relative_to(r) for r in [repo, *roots]),
            'installation target cannot be inside a source checkout')
    require(not recover_dangling or not any(r.is_relative_to(target) for r in roots),
            'recovery source cannot be inside the installation target')
    modes = {key: True for key, enabled in (
        ('recover_dangling', recover_dangling), ('force_links', force_links)) if enabled}
    snapshot = plan(repo, target, package, roots, **modes)
    print(f'Repository: {repo}\nTarget: {target}\nPackage: {package}')
    if recover_dangling:
        print('Dangling-link recovery: old payload and ownership cannot be verified; '
              'approval uses exact link text and the selected missing roots only.')
    if force_links:
        print('Forced link replacement: unproven leaf links may be replaced; '
              'their payload is not read or compared. Target existence is checked '
              'for final follow-up. Regular files remain conflicts.')
    for root in roots:
        label = 'Selected source repository' if explicit_roots else 'Detected source candidate'
        print(f'{label}: {root}')
    if not roots:
        print('No other source checkout detected at declared package paths.')
    for row in snapshot['rows']:
        detail = ' (payload differs)' if row['content_changed'] else ''
        print(f'{row["state"]}: {row["path"]}{detail}')
        if row['state'] == 'force-link':
            print('  replace link text: ' + json.dumps(row['old'], ensure_ascii=True) +
                  ' -> ' + json.dumps(row['new'], ensure_ascii=True))
        if row['from_repo'] is not None:
            print(f'  from repository: {row["from_repo"]}')
    require(not snapshot['conflicts'], 'conflicts or unmapped legacy residue; no changes made')
    stow_projection(repo, package, snapshot['files'])
    return roots, snapshot


def inspect_all(repo, target, explicit_roots, recover_dangling=False, force_links=False):
    directories(repo / 'stow')
    packages = sorted(path.name for path in (repo / 'stow').iterdir())
    require(packages, 'no user packages to inspect')
    failures = pending = 0
    for package in packages:
        try:
            _, snapshot = prepare(repo, target, package, explicit_roots, recover_dangling, force_links)
            pending += any(row['state'] not in {'current', 'absent-legacy'} for row in snapshot['rows'])
        except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
            failures += 1
            print(f'Inspection failed for {package!r}: {error}', file=sys.stderr)
    print(f'Inspection summary: {len(packages)} packages, {pending} need migration, {failures} failed; no changes made.')
    return 1 if failures else 3 if pending else 0


def batch_selection(repo):
    """Bind the selected names, Stow links and exclusion policy to approval."""
    directories(repo / 'stow')
    entries = {}
    for path in sorted((repo / 'stow').iterdir()):
        require(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', path.name) and
                path.name not in {'all', 'all-user', 'all-system'}, 'invalid batch package name')
        require(path.is_symlink() and os.readlink(path) == f'../packages/{path.name}/install',
                f'invalid Stow package mapping: {path}')
        entries[path.name] = (identity(path), os.readlink(path))
    policy = repo / 'manifests/ignore-all-install.txt'
    directories(policy.parent, missing=True)
    entry = identity(policy)
    excluded = set()
    policy_state = None
    if entry is not None:
        require(stat.S_ISREG(entry[2]), 'aggregate exclusion policy must be a regular file')
        raw = policy.read_bytes()
        policy_state = (entry, hashlib.sha256(raw).hexdigest())
        for line in raw.decode('utf-8').splitlines():
            if not line or line.startswith('#'):
                continue
            require(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', line) and
                    line not in {'all', 'all-user', 'all-system'}, 'invalid aggregate exclusion entry')
            excluded.add(line)
    selected = [name for name in entries if name not in excluded]
    require(selected, 'no user packages selected for aggregate rebind')
    return {'selected': selected, 'excluded': sorted(set(entries) & excluded),
            'entries': entries, 'policy': policy_state}


def prepare_batch(repo, target, explicit_roots, recover_dangling=False, force_links=False):
    selection = batch_selection(repo)
    print('Selected user packages: ' + ', '.join(selection['selected']))
    print('Excluded user packages: ' + (', '.join(selection['excluded']) or '(none)'))
    prepared, failures, owned = {}, {}, {}
    try:
        for package in selection['selected']:
            try:
                roots, snapshot = prepare(repo, target, package, explicit_roots, recover_dangling, force_links)
                prepared[package] = (roots, snapshot)
            except Interrupted:
                raise
            except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
                failures[package] = str(error)
                print(f'Batch preflight failed for {package!r}: {error}', file=sys.stderr)
        # Overlapping plans cannot establish independent package transactions.
        for package, (_, snapshot) in prepared.items():
            for row in snapshot['rows']:
                path = Path(row['path'])
                for other, owner in owned.items():
                    require(path != other and not path.is_relative_to(other) and not other.is_relative_to(path),
                            f'overlapping batch destinations: {owner}, {package}: {path}')
                owned[path] = package
        require(batch_selection(repo) == selection, 'batch selection changed during preflight')
    except BaseException:
        print_batch_results(selection, {name: {'state': 'failed' if name in failures else 'unattempted',
                            'outcome': {'status': 'blocked' if name in failures else 'not-started',
                                        'retained_changes': 0}} for name in selection['selected']})
        raise
    return selection, prepared, failures


def stow_projection(repo, package, files):
    stow = shutil.which('stow')
    require(stow, 'GNU Stow is required')
    with tempfile.TemporaryDirectory(prefix='runner-rebind-projection-', dir='/tmp') as directory:
        scratch = Path(directory)
        projected = scratch / 'target'
        projected.mkdir()
        args = [stow, '--dir', str(repo / 'stow'), '--target', str(projected), '--no-folding']
        args += ['--ignore=' + pattern for pattern in IGNORES]
        args += ['--stow', '--', package]
        result = subprocess.run(args, cwd=scratch, env={'PATH': os.environ['PATH'], 'HOME': str(scratch)},
                                capture_output=True, timeout=60)
        require(result.returncode == 0, 'Stow projection failed; no live paths were changed')
        actual = set()
        for directory, dirs, names in os.walk(projected, followlinks=False, onerror=unreadable_tree):
            require(all(not (Path(directory) / name).is_symlink() for name in dirs), 'Stow folded a directory')
            for name in names:
                p = Path(directory) / name
                rel = p.relative_to(projected).as_posix()
                require(p.is_symlink() and rel in files and
                        p.resolve(strict=True) == repo / 'packages' / package / 'install' / rel,
                        'Stow projection differs from the reviewed inventory')
                actual.add(rel)
        require(actual == set(files), 'Stow omitted package files')


def parent_fd(target, rel, created):
    fd = os.open(target, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    current = target
    try:
        for name in Path(rel).parts[:-1]:
            current = current / name
            try:
                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except FileNotFoundError:
                with mutation_record():
                    os.mkdir(name, dir_fd=fd)
                    created.append((current, identity(current)))
                    os.fsync(fd)
                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def verify_result(target, repo, package, snapshot):
    for row in snapshot['rows']:
        p = target / row['path']
        directories(p.parent, missing=row['new'] is None)
        if row['new'] is not None:
            require(p.is_symlink() and p.resolve(strict=True) == repo / 'packages' / package / 'install' / row['path'],
                    f'final link verification failed: {row["path"]}')
        else:
            require(identity(p) is None, f'legacy path remains: {row["path"]}')


@contextmanager
def target_lock(target):
    # Advisory lock shared across all packages; no lock file is created in HOME.
    fd = os.open(target, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield
    finally:
        os.close(fd)


def apply(repo, target, package, roots, snapshot):
    with target_lock(target):
        return apply_locked(repo, target, package, roots, snapshot)


def check_parents(snapshot, created, leaf=None):
    owned = {str(path): entry[:3] for path, entry in created}
    for path, expected in snapshot['parents'].items():
        if leaf is not None and not leaf.parent.is_relative_to(Path(path)):
            continue
        now = identity(Path(path))
        require((now[:3] if now else None) == owned.get(path, expected),
                f'parent changed after approval: {path}')


def original_state_conflicts(target, snapshot, changed):
    """Verify the whole package's link state after rollback, without resolving links."""
    conflicts = []
    replaced = {row['path'] for row, _ in changed}
    for row in snapshot['rows']:
        path = target / row['path']
        try:
            check_parents(snapshot, [], path)
            now = identity(path)
            if row['before'] is None:
                require(now is None, 'originally missing path now exists')
            else:
                require(now is not None and stat.S_ISLNK(now[2]) and
                        now[2] == row['before'][2] and os.readlink(path) == row['old'],
                        'original link was not restored')
                if row['path'] not in replaced:
                    require(now == row['before'], 'unchanged path identity changed')
        except (OSError, Refusal):
            conflicts.append(row['path'])
    return conflicts


def probe_detached_target(reference):
    try:
        os.stat(reference)  # Existence only; never read target contents.
        return 'exists'
    except (FileNotFoundError, NotADirectoryError):
        return 'missing'
    except OSError:
        return 'unknown'  # Permission errors and loops are not proof of absence.


def update_detached_targets(target, outcome, probe=True):
    """Metadata-only follow-up for actually changed forced leaves, never cleanup."""
    if not outcome.get('forced_links'):
        return
    checks = []
    missing = 0
    for row in outcome['forced_links']:
        installed = target / row['path']
        reference = os.path.join(str(installed.parent), row['old'])
        # Leading relative '..' is safe to normalize through validated parents.
        # Preserve noncanonical spellings: collapsing interior '..' through an
        # unknown symlink would describe a different target.
        location = (os.path.abspath(reference) if os.path.normpath(row['old']) == row['old']
                    else reference)
        link_state = 'unverified'
        target_state = 'unknown'
        try:
            directories(installed.parent)
            entry = identity(installed)
            if entry and stat.S_ISLNK(entry[2]):
                raw = os.readlink(installed)
                if raw == row['old']:
                    continue  # Rollback (or another writer) restored the reference.
                if raw == row['new']:
                    link_state = 'replaced'
            if probe:
                target_state = probe_detached_target(reference)
            if target_state == 'missing':
                missing += 1
                continue
        except Interrupted:
            raise
        except (OSError, Refusal):
            pass  # Unsafe/changed parents: retain an explicitly uncertain check.
        checks.append({'old_target': location, 'installed_path': str(installed),
                       'link_state': link_state, 'target_state': target_state})
    outcome['detached_targets'] = checks
    outcome['omitted_missing_targets'] = missing


def record_forced_links(target, outcome, changed):
    rows = [{'path': row['path'], 'old': row['old'], 'new': row['new']}
            for row, _ in changed if row['state'] == 'force-link']
    if rows:
        outcome['forced_links'] = rows
        # Persist conservative evidence before any potentially blocking lookup.
        update_detached_targets(target, outcome, probe=False)


def refresh_batch_target_reports(target, packages, probe=True):
    for result in packages.values():
        update_detached_targets(target, result.get('outcome', {}), probe=probe)


def print_detached_targets(outcomes):
    if not any(outcome.get('forced_links') for outcome in outcomes.values()):
        return
    groups = {}
    missing = sum(outcome.get('omitted_missing_targets', 0) for outcome in outcomes.values())
    for package, outcome in outcomes.items():
        for row in outcome.get('detached_targets', []):
            location = row['old_target']
            group = groups.setdefault(str(Path(location).parent), {})
            group.setdefault(location, []).append((package, row, outcome['status']))
    print('Detached forced targets to inspect (grouped by directory; no cleanup performed):', flush=True)
    for directory, targets in sorted(groups.items()):
        print('  Directory: ' + json.dumps(directory, ensure_ascii=True), flush=True)
        for location, rows in sorted(targets.items()):
            state = 'unknown' if any(row['target_state'] == 'unknown' for _, row, _ in rows) else 'exists'
            print('    Target: ' + json.dumps(location, ensure_ascii=True) + f' [{state}]', flush=True)
            for package, row, status in sorted(rows, key=lambda item: (item[0], item[1]['installed_path'])):
                print(f'      {package}: ' + json.dumps(row['installed_path'], ensure_ascii=True) +
                      f' [{row["link_state"]}; {status}]', flush=True)
    if not groups:
        print('  No detached targets requiring a check.', flush=True)
    if missing:
        print(f'  Confirmed missing targets omitted: {missing}', flush=True)


def print_package_result(package, outcome):
    retained = outcome.get('retained_changes')
    count = str(retained) if retained is not None else 'unknown'
    print(f'Package result: {package}: {outcome["status"]}; retained link changes: {count}', flush=True)
    for path in outcome.get('recovery_paths', []):
        print(f'  Manual recovery check: {path}', flush=True)


def print_batch_results(selection, packages):
    print('Final package results:', flush=True)
    for package in selection['selected']:
        result = packages[package]
        outcome = result.get('outcome', {'status': 'not-started' if result['state'] == 'failed'
                                        else result['state'], 'retained_changes': 0})
        print_package_result(package, outcome)
        if result.get('error'):
            print(f'  Package error: {result["error"]}', flush=True)
    for package in selection['excluded']:
        print_package_result(package, {'status': 'excluded', 'retained_changes': 0})


def apply_locked(repo, target, package, roots, snapshot, on_journal=None, on_complete=None, on_failure=None):
    """One conservative transaction; caller owns the target lock."""
    changed, created = [], []
    journal = None
    complete = False
    reported = False
    try:
        require(refresh_plan(repo, target, package, roots, snapshot) == snapshot,
                'candidate changed after approval; rerun')
        journal = new_journal('runner-rebind-journal-') / 'before.json'
        write_record(journal, {'repository': str(repo), 'target': str(target), 'package': package,
                               'snapshot': snapshot})
        print(f'Rollback journal: {journal}', flush=True)
        if on_journal:
            on_journal(journal)
        for row in snapshot['rows']:
            if row['state'] in {'current', 'absent-legacy'}:
                continue
            p = target / row['path']
            check_parents(snapshot, created)
            parent = parent_fd(target, row['path'], created)
            try:
                check_parents(snapshot, created)
                require(identity(p) == row['before'], f'live path changed: {row["path"]}')
                if row['old'] is not None:
                    require(os.readlink(p) == row['old'], 'live link changed')
                temporary = '.runner-rebind-' + uuid.uuid4().hex
                if row['new'] is not None:
                    try:
                        os.symlink(row['new'], temporary, dir_fd=parent)
                        own = os.stat(temporary, dir_fd=parent, follow_symlinks=False)
                        expected = (own.st_dev, own.st_ino)
                        # Recheck immediately before publication, not only before staging.
                        check_parents(snapshot, created)
                        require(identity(p) == row['before'], 'live path changed before publication')
                        with mutation_record():
                            if row['before'] is None:
                                # link() gives no-clobber publication for previously absent paths.
                                os.link(temporary, p.name, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
                            else:
                                os.replace(temporary, p.name, src_dir_fd=parent, dst_dir_fd=parent)
                            changed.append((row, expected))
                    finally:
                        try:
                            os.unlink(temporary, dir_fd=parent)
                        except FileNotFoundError:
                            pass
                else:
                    check_parents(snapshot, created)
                    with mutation_record():
                        os.unlink(p.name, dir_fd=parent)
                        changed.append((row, None))
            finally:
                try:
                    os.fsync(parent)
                finally:
                    os.close(parent)
        fresh = refresh_plan(repo, target, package, roots, snapshot)
        check_parents(snapshot, created)
        require(source_unchanged(fresh, snapshot),
                'source changed during transaction')
        verify_result(target, repo, package, snapshot)
        outcome = {'status': 'rebound' if changed else 'unchanged',
                   'retained_changes': len(changed), 'verification': 'current'}
        result = {'journal': str(journal), 'created': created, 'outcome': outcome}
        with mutation_record():
            record_forced_links(target, outcome, changed)
            write_record(journal.with_name('result.json'), outcome)
            if on_complete:
                on_complete(result)
            complete = True
        try:
            if outcome.get('forced_links'):
                update_detached_targets(target, outcome)
                with mutation_record():
                    write_record(journal.with_name('result.json'), outcome)
        finally:
            reported = True
            print('Rebind verified; hooks, system files and service state were not touched.')
            if on_complete is None:
                print_package_result(package, outcome)
                print_detached_targets({package: outcome})
        return result
    except BaseException as error:
        if complete:
            if not reported and on_complete is None:
                print_package_result(package, outcome)
                print_detached_targets({package: outcome})
            raise  # Already committed and durably reported to a batch caller.
        # A second handled signal must not interrupt rollback halfway through.
        with mutation_record():
            outcome = rollback_package(target, snapshot, changed, created, journal)
            if journal is not None:
                try:
                    write_record(journal.with_name('result.json'), outcome)
                except OSError:
                    print(f'Could not record package result; journal: {journal}', file=sys.stderr)
            if on_failure:
                on_failure(outcome)
        try:
            if outcome.get('forced_links') and not isinstance(error, (Interrupted, KeyboardInterrupt)):
                update_detached_targets(target, outcome)
                if journal is not None:
                    with mutation_record():
                        write_record(journal.with_name('result.json'), outcome)
        finally:
            if on_failure is None:
                print_package_result(package, outcome)
                print_detached_targets({package: outcome})
        raise


def rollback_package(target, snapshot, changed, created, journal):
    errors = set()
    for row, own in reversed(changed):
        p = target / row['path']
        try:
            check_parents(snapshot, created, p)
            directories(p.parent)
            def still_owned():
                now = identity(p)
                require((now is None if own is None else now is not None and now[:2] == own and
                         p.is_symlink() and os.readlink(p) == row['new']), 'rollback ownership lost')
            still_owned()
            parent = os.open(p.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                if row['old'] is None:
                    p.unlink()
                else:
                    temp = p.with_name('.runner-rebind-rollback-' + uuid.uuid4().hex)
                    try:
                        temp.symlink_to(row['old'])
                        check_parents(snapshot, created, p)
                        still_owned()
                        if own is None:
                            os.link(temp, p, follow_symlinks=False)
                        else:
                            os.replace(temp, p)
                    finally:
                        if temp.is_symlink():
                            temp.unlink()
            finally:
                try:
                    os.fsync(parent)
                finally:
                    os.close(parent)
        except (OSError, Refusal):
            errors.add(row['path'])
            print(f'Manual rollback required: {p}; journal: {journal}', file=sys.stderr)
    for directory, own in reversed(created):
        try:
            current = identity(directory)
            if current and current[:2] == own[:2] and stat.S_ISDIR(current[2]):
                directory.rmdir()  # Empty directories created by this transaction only.
                sync_directory(directory.parent)
        except OSError:
            errors.add(str(directory.relative_to(target)))
    conflicts = sorted(errors | set(original_state_conflicts(target, snapshot, changed)))
    outcome = {'status': 'manual-recovery' if conflicts else 'rolled-back' if changed else 'not-started',
               'retained_changes': None if conflicts else 0,
               'verification': 'unverified' if conflicts else 'original', 'recovery_paths': conflicts}
    record_forced_links(target, outcome, changed)
    return outcome


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def new_journal(prefix):
    journal = Path(tempfile.mkdtemp(prefix=prefix, dir='/tmp'))
    sync_directory(journal)
    sync_directory(journal.parent)
    return journal


def write_record(path, progress):
    temporary = path.with_name('.progress-' + uuid.uuid4().hex)
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(progress, handle, indent=2)
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        if temporary.exists():
            temporary.unlink()


def write_progress(path, progress):
    write_record(path, progress)


def batch_snapshot(repo, target, package, roots, snapshot, created):
    fresh = refresh_plan(repo, target, package, roots, snapshot)
    expected = dict(snapshot)
    expected['parents'] = {path: created.get(path) if value is None and path in created else value
                           for path, value in snapshot['parents'].items()}
    require(fresh == expected, f'candidate changed after approval: {package}; rerun')
    return expected


def apply_batch(repo, target, selection, prepared, failures=None):
    failures = failures or {}
    progress = {'repository': str(repo), 'target': str(target), 'selection': selection,
                'packages': {package: {'state': 'failed', 'error': failures[package], 'outcome': {
                    'status': 'blocked', 'retained_changes': 0}} if package in failures else {
                    'state': 'unattempted'} for package in selection['selected']},
                'plans': {package: {'roots': list(map(str, roots)), 'snapshot': snapshot}
                          for package, (roots, snapshot) in prepared.items()}, 'state': 'running',
                'stage': 'before-writes'}
    created = {}
    journal = None
    current = None
    locks = ExitStack()
    try:
        locks.enter_context(target_lock(target))
        require(batch_selection(repo) == selection, 'batch selection changed after approval; rerun')
        # Revalidate the entire approved batch before the first installed write.
        for package, (roots, snapshot) in prepared.items():
            try:
                batch_snapshot(repo, target, package, roots, snapshot, created)
            except Interrupted:
                raise
            except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
                progress['packages'][package].update(state='failed', error=str(error), outcome={
                    'status': 'not-started', 'retained_changes': 0})
        journal = new_journal('runner-rebind-batch-') / 'progress.json'
        progress['stage'] = 'packages'
        write_progress(journal, progress)
        print(f'Batch recovery journal: {journal}', flush=True)
        for package, (roots, snapshot) in prepared.items():
            current = package
            require(batch_selection(repo) == selection, 'batch selection changed during execution')
            if progress['packages'][package]['state'] == 'failed':
                continue

            def started(path):
                progress['packages'][package]['journal'] = str(path)
                write_progress(journal, progress)

            def completed(result):
                previous = dict(progress['packages'][package])
                progress['packages'][package].update(state='completed', outcome=result['outcome'])
                try:
                    write_progress(journal, progress)
                except BaseException:
                    progress['packages'][package].clear()
                    progress['packages'][package].update(previous)
                    raise
                created.update({str(path): entry[:3] for path, entry in result['created']})

            def failed(outcome):
                progress['packages'][package]['outcome'] = outcome
                write_progress(journal, progress)

            try:
                approved = batch_snapshot(repo, target, package, roots, snapshot, created)
                progress['packages'][package]['state'] = 'running'
                write_progress(journal, progress)
                apply_locked(repo, target, package, roots, approved, started, completed, failed)
            except Interrupted:
                raise
            except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
                result = progress['packages'][package]
                result.update(state='failed', error=str(error))
                result.setdefault('outcome', {'status': 'not-started', 'retained_changes': 0})
                # Continuation requires a writable recovery record. Persistent
                # journal failures escape here and stop the batch.
                write_progress(journal, progress)
        current = None
        progress['stage'] = 'final-verification'
        write_progress(journal, progress)
        require(batch_selection(repo) == selection, 'batch selection changed during execution')
        for package, (roots, snapshot) in prepared.items():
            result = progress['packages'][package]
            if result['state'] != 'completed':
                continue
            try:
                fresh = refresh_plan(repo, target, package, roots, snapshot)
                check_parents(snapshot, [(Path(path), entry) for path, entry in created.items()])
                require(source_unchanged(fresh, snapshot),
                        f'source changed during batch: {package}')
                verify_result(target, repo, package, snapshot)
            except Interrupted:
                raise
            except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
                result['error'] = str(error)
                result['outcome'] = {**result.get('outcome', {}),
                                     'status': 'final-state-unverified', 'verification': 'unverified',
                                     'retained_changes': None}
        errors = [name for name, result in progress['packages'].items() if result.get('error')]
        progress['state'] = 'failed' if errors else 'completed'
        progress['stage'] = 'complete'
        refresh_batch_target_reports(target, progress['packages'])
        write_progress(journal, progress)
        if errors:
            raise Refusal('batch completed with package failures: ' + ', '.join(errors))
    except BaseException as failure:
        with mutation_record():
            progress['state'] = 'failed'
            if current is not None and progress['packages'][current]['state'] != 'completed':
                progress['packages'][current]['state'] = 'failed'
            # Report the current final state, not merely a previous successful callback.
            for package, result in progress['packages'].items():
                if result['state'] != 'completed':
                    continue
                try:
                    roots, snapshot = prepared[package]
                    fresh = refresh_plan(repo, target, package, roots, snapshot)
                    check_parents(snapshot, [(Path(path), entry) for path, entry in created.items()])
                    require(source_unchanged(fresh, snapshot),
                            'completed package source changed')
                    verify_result(target, repo, package, snapshot)
                except (Refusal, OSError, ValueError, subprocess.SubprocessError) as error:
                    result['error'] = str(error)
                    result['outcome'] = {**result.get('outcome', {}),
                                         'status': 'final-state-unverified', 'verification': 'unverified',
                                         'retained_changes': None}
            refresh_batch_target_reports(target, progress['packages'], probe=False)
            if journal is not None:
                try:
                    with mutation_record():
                        write_progress(journal, progress)
                except OSError:
                    print(f'Could not update batch recovery journal: {journal}', file=sys.stderr)
        # No foreign target lookup may run in the signal-masked recovery path.
        # An interrupted report must not retry the same potentially stuck lookup.
        if not isinstance(failure, (Interrupted, KeyboardInterrupt)) and any(
                result.get('outcome', {}).get('forced_links') for result in progress['packages'].values()):
            refresh_batch_target_reports(target, progress['packages'])
            if journal is not None:
                with mutation_record():
                    write_progress(journal, progress)
        raise
    finally:
        try:
            with mutation_record():
                for state in ('completed', 'failed', 'unattempted'):
                    names = [name for name, result in progress['packages'].items() if result['state'] == state]
                    print(f'Batch {state} packages: ' + (', '.join(names) or '(none)'), flush=True)
                print_batch_results(selection, progress['packages'])
                print_detached_targets({name: result.get('outcome', {})
                                        for name, result in progress['packages'].items()})
                print(f'Batch status: {progress["state"]}; stage: {progress["stage"]}', flush=True)
                if journal is not None:
                    print(f'Batch recovery journal: {journal}', flush=True)
        finally:
            locks.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--package', required=True)
    parser.add_argument('--target', required=True)
    parser.add_argument('--from-repo', '--legacy-root', dest='from_repo', action='append', default=[])
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--inspect', action='store_true')
    parser.add_argument('--recover-dangling', action='store_true')
    parser.add_argument('--force-links', action='store_true')
    parser.add_argument('--yes', action='store_true')
    args = parser.parse_args()
    repo = absolute(str(Path(__file__).absolute().parent.parent))
    target = absolute(args.target)
    require(not args.recover_dangling or args.from_repo,
            '--recover-dangling requires explicit --from-repo values')
    require(not args.force_links or args.from_repo,
            '--force-links requires explicit --from-repo values')
    explicit_roots = [absolute(value, missing=args.recover_dangling) for value in args.from_repo]
    if args.inspect and args.package == 'all-user':
        return inspect_all(repo, target, explicit_roots, args.recover_dangling, args.force_links)
    if args.package == 'all-user':
        selection, prepared, failures = prepare_batch(repo, target, explicit_roots,
                                                     args.recover_dangling, args.force_links)
        if args.dry_run:
            print_batch_results(selection, {package: {'state': 'unattempted', 'outcome': {
                'status': 'blocked' if package in failures else 'preview-only', 'retained_changes': 0},
                'error': failures.get(package)} for package in selection['selected']})
            print('Read-only batch preflight complete; no installed paths changed.')
            return 1 if failures else 0
        try:
            approve(args, explicit_roots)
        except BaseException:
            print_batch_results(selection, {package: {'state': 'unattempted', 'outcome': {
                'status': 'not-started', 'retained_changes': 0}} for package in selection['selected']})
            raise
        apply_batch(repo, target, selection, prepared, failures)
        return 0
    roots, snapshot = prepare(repo, target, args.package, explicit_roots,
                              args.recover_dangling, args.force_links)
    if args.dry_run or args.inspect:
        print('Read-only preflight complete; no installed paths changed.')
        if roots and any(row['state'] not in {'current', 'absent-legacy'} for row in snapshot['rows']):
            command = ['python3', '-I', str(repo / 'scripts/rebind-user-package'),
                       '--target', str(target), '--package', args.package]
            if args.recover_dangling:
                command += ['--recover-dangling']
            if args.force_links:
                command += ['--force-links']
            for root in roots:
                command += ['--from-repo', str(root)]
            print('Review explicit dry-run: ' + shlex.join(command + ['--dry-run']))
        return 3 if args.inspect and any(row['state'] not in {'current', 'absent-legacy'}
                                        for row in snapshot['rows']) else 0
    approve(args, explicit_roots)
    apply(repo, target, args.package, roots, snapshot)


def approve(args, explicit_roots):
    require(not args.yes or explicit_roots,
            '--yes requires explicit --from-repo values; discovered sources require interactive approval')
    if not args.yes:
        require(sys.stdin.isatty(), 'interactive approval required; review dry-run, then specify --from-repo and --yes')
        phrase = 'FORCE REBIND' if args.force_links else 'REBIND'
        require(input(f'Rebind user links for {args.package}? Type {phrase}: ') == phrase, 'cancelled')


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise Interrupted(f'interrupted by signal {signum}')
    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(main())
    except (Refusal, OSError, ValueError, subprocess.SubprocessError, KeyboardInterrupt) as error:
        print(f'rebind refused: {error}', file=sys.stderr)
        sys.exit(1)
