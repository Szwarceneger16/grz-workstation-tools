#!/usr/bin/env zsh
emulate -L zsh
set -euo pipefail

# Repository-local public policy. Read indexed bytes, not the worktree, filters
# or grep's text/binary classification. Report paths/categories, never values.
# No external policy, consumer information or blanket scanner-file exclusion.
exec python3 -I - "${0:A:h:h}" <<'PY'
import json
import re
import subprocess
import sys


def git(*args):
    result = subprocess.run(["git", "--no-replace-objects", *args], cwd=sys.argv[1],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        raise ValueError("cannot read index objects")
    return result.stdout


credential = re.compile(rb"-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}")
home = re.compile(rb"(?:/home/|/Users/)[A-Za-z0-9._-]+")
words = re.compile(rb"password|passwd[\"']?\s*[:=]|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret", re.I)

try:
    findings = 0
    for record in git("ls-files", "--stage", "-z").split(b"\0"):
        if not record:
            continue
        metadata, raw_path = record.split(b"\t", 1)
        mode, oid, stage = metadata.split()
        if stage != b"0" or mode not in {b"100644", b"100755", b"120000"}:
            raise ValueError("unmerged or unsupported index entry")
        path = raw_path.decode("utf-8", "strict")
        # Includes binary bytes and symlink target text; never follow the link.
        payload = git("cat-file", "blob", oid.decode("ascii"))
        categories = []
        if credential.search(payload):
            categories.append("credential")
        if any(match.group() != b"/home/runner" for match in home.finditer(payload)):
            categories.append("home-path")
        parts = path.split("/")
        if (len(parts) >= 4 and parts[0] == "packages" and parts[2] in {"install", "system-install"}
                and not path.endswith(".example") and words.search(payload)):
            categories.append("secret-word")
        for category in categories:
            label = path if re.fullmatch(r"[A-Za-z0-9._/@+-]+", path) else json.dumps(path, ensure_ascii=True)
            print(f"audit-public-safety: POSSIBLE LEAK [{category}]: {label}", file=sys.stderr)
            findings += 1
    if findings:
        print(f"audit-public-safety: FAILED with {findings} finding(s)", file=sys.stderr)
        sys.exit(1)
    print("audit-public-safety: ok")
except (OSError, UnicodeError, ValueError):
    # Git errors may contain candidate data. Never include raw exception text.
    print("audit-public-safety: ERROR: indexed content could not be validated", file=sys.stderr)
    sys.exit(2)
PY
