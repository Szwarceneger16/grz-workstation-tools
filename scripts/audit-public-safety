#!/usr/bin/env zsh
emulate -L zsh
set -euo pipefail

# Public-safety scanner.
#
# Fails if anything that will ACTUALLY be published looks like personal data or a
# credential. Scope = tracked files (what `git` would publish); untracked and
# git-ignored files (e.g. .claude/settings*.json) are intentionally not scanned.
#
# Per AGENTS.md this reports only the file path + category, never the matched value
# (so it is safe to run in CI logs).
#
# Two tiers keep it precise:
#   Tier A  whole tracked tree   high-signal leaks that never appear in real docs
#                                (credential formats, absolute personal home paths)
#   Tier B  packages/*/install   generic secret-ish words, only in shipped runtime
#                                code (these words legitimately appear in README /
#                                AGENTS.md / CI as documentation, so are not failed
#                                there)

repo_root="${0:A:h:h}"
cd "$repo_root" || { print -u2 -- 'audit-public-safety: cannot cd to repo root'; exit 2; }

command -v git >/dev/null 2>&1 || { print -u2 -- 'audit-public-safety: git is required'; exit 2; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
  { print -u2 -- 'audit-public-safety: not inside a git work tree'; exit 2; }

self="${${0:A}#$repo_root/}"   # this script's repo-relative path (excluded from scans)
findings=0

report() {
  local category="$1"; shift
  local f
  for f in "$@"; do
    [[ -n "$f" ]] || continue
    print -u2 -- "audit-public-safety: POSSIBLE LEAK [$category]: $f"
    findings=$(( findings + 1 ))
  done
}

# List indexed files (staged / committed) matching an ERE under the given pathspecs.
# `-l` prints file names only (never the matched text); exit 1 (no match) is fine.
# Optional single-letter flags (e.g. -i for case-insensitive) may be passed before the pattern.
scan() {
  local -a flags=()
  while [[ "${1-}" == -[a-zA-Z] ]]; do flags+=("$1"); shift; done
  local pattern="$1"; shift
  git grep --cached -lIE "${flags[@]}" -e "$pattern" -- "$@" 2>/dev/null || true
}

# ---- Tier A -----------------------------------------------------------------

# Concrete credential formats: private keys and provider tokens. Never legitimate.
cred_pattern='-----BEGIN ([A-Z]+ )?PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}'
typeset -a cred_hits
cred_hits=(${(f)"$(scan "$cred_pattern" . ":!$self")"})
cred_hits=(${cred_hits:#})
(( ${#cred_hits} )) && report 'credential' "${cred_hits[@]}"

# Absolute personal home paths (deanonymizing). /home/runner is the GitHub
# Actions runner home — a known-safe placeholder; files whose only home-path
# hits are /home/runner are not flagged.
home_pattern='(/home/|/Users/)[A-Za-z0-9._-]+'
typeset -a home_raw home_hits=()
home_raw=(${(f)"$(scan "$home_pattern" . ":!$self")"})
home_raw=(${home_raw:#})
for f in "${home_raw[@]}"; do
  git grep --cached -IhE -e "$home_pattern" -- "$f" 2>/dev/null \
    | grep -qvE '/home/runner([^A-Za-z0-9._-]|$)' \
    && home_hits+=("$f") || true
done
(( ${#home_hits} )) && report 'home-path' "${home_hits[@]}"

# ---- Tier B -----------------------------------------------------------------

typeset -a install_dirs
install_dirs=(packages/*/install(N/))
if (( ${#install_dirs} )); then
  word_pattern='password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret'
  typeset -a word_hits
  word_hits=(${(f)"$(scan -i "$word_pattern" "${install_dirs[@]}")"})
  word_hits=(${word_hits:#*.example})
  word_hits=(${word_hits:#})
  (( ${#word_hits} )) && report 'secret-word' "${word_hits[@]}"
fi

# ---- Result -----------------------------------------------------------------

if (( findings > 0 )); then
  print -u2 -- "audit-public-safety: FAILED with $findings finding(s)"
  exit 1
fi

print -- 'audit-public-safety: ok'
