#!/usr/bin/env zsh
emulate -L zsh
set -euo pipefail

script_name="${0:t}"
repo_root="${0:A:h:h}"
packages_dir="$repo_root/packages"
ignore_all_file="$repo_root/manifests/ignore-all-install.txt"
protected_paths_file="$repo_root/manifests/protected-system-paths.txt"
typeset -ga protected_paths
protected_paths=()
sudo_session_active=0

# --- Per-repo runner config (env-var prefix). NOT part of the synced canonical engine. ---
runner_conf="$repo_root/runner.conf"
[[ -r "$runner_conf" ]] && source "$runner_conf"
: "${RUNNER_ENV_PREFIX:?runner.conf must define RUNNER_ENV_PREFIX (e.g. GRZ)}"
env_prefix="$RUNNER_ENV_PREFIX"

finish_sudo_session() {
  (( sudo_session_active )) || return 0
  local _keep_var="${env_prefix}_KEEP_SUDO_SESSION"
  if [[ "${(P)_keep_var:-0}" == "1" ]]; then
    sudo_session_active=0
    return 0
  fi
  sudo -k
  sudo_session_active=0
}

trap finish_sudo_session EXIT

usage() {
  print -u2 -- "usage: $script_name install|uninstall [--verbose] all|all-system|<package>"
  print -u2 -- "       $script_name activate all|all-system|<package>"
}

die() {
  print -u2 -- "$script_name: $*"
  exit 1
}

confirm_action() {
  local prompt="$1"
  local answer=""

  [[ -r /dev/tty && -w /dev/tty ]] || die "interactive confirmation requires a TTY"
  printf '%s [y/N] ' "$prompt" > /dev/tty
  IFS= read -r answer < /dev/tty

  case "$answer" in
    y|Y|yes|YES)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

start_sudo_session() {
  local description="$1"

  (( sudo_session_active )) && return 0

  print -- "$description"
  sudo -k
  sudo -v
  sudo_session_active=1
}

validate_package_name() {
  local package="$1"
  [[ "$package" =~ '^[A-Za-z0-9._-]+$' ]] || die "invalid package name: $package"
}

package_has_system_install() {
  local package="$1"
  [[ -d "$packages_dir/$package/system-install" ]]
}

validate_system_package() {
  local package="$1"
  validate_package_name "$package"
  package_has_system_install "$package" || die "unknown system package: $package"
}

load_ignored_packages() {
  local line package
  typeset -gA ignored_packages
  ignored_packages=()

  [[ -f "$ignore_all_file" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    package="$line"
    validate_package_name "$package"
    ignored_packages[$package]=1
  done < "$ignore_all_file"
}

select_packages() {
  local selector="$1"
  local package_path package
  typeset -ga selected_packages
  selected_packages=()

  case "$selector" in
    all|all-system)
      load_ignored_packages
      for package_path in "$packages_dir"/*/system-install(N/); do
        package="${package_path:h:t}"
        [[ "$selector" == "all" && -n "${ignored_packages[$package]-}" ]] && continue
        selected_packages+=("$package")
      done
      if [[ "$selector" == "all-system" ]]; then
        (( ${#selected_packages[@]} > 0 )) || die "no system packages selected from: $packages_dir"
      fi
      ;;
    all-user)
      die "all-user is not a system selector"
      ;;
    *)
      validate_system_package "$selector"
      selected_packages=("$selector")
      ;;
  esac
}

is_meta_file() {
  local rel_path="$1"
  # Files Stow ignores and never links (mirror scripts/check-repo is_meta_file and
  # is_install_meta_file in run.sh): git metadata and stow markers a package may
  # carry without being installed. Skipped here so a system package carrying such
  # a file with no manifest entry is not rejected during collection (which would
  # otherwise diverge from check-repo, which already treats these as meta).
  case "$rel_path" in
    .gitkeep|*/.gitkeep|.stow-local-ignore|*/.stow-local-ignore)
      return 0
      ;;
    .gitignore|*/.gitignore|.gitattributes|*/.gitattributes|.gitmodules|*/.gitmodules)
      return 0
      ;;
    .git/*|*/.git/*)
      return 0
      ;;
  esac
  return 1
}

load_protected_paths() {
  local line
  protected_paths=()

  [[ -f "$protected_paths_file" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    protected_paths+=("$line")
  done < "$protected_paths_file"
}

is_protected_rel_path() {
  local rel_path="$1"
  local pattern

  for pattern in "${protected_paths[@]}"; do
    [[ "$rel_path" == ${~pattern} ]] && return 0
  done

  return 1
}

normalize_mode() {
  local mode="$1"

  [[ "$mode" =~ '^[0-7]{3,4}$' ]] || return 1
  while [[ ${#mode} -gt 1 && "$mode" == 0* ]]; do
    mode="${mode#0}"
  done
  print -- "$mode"
}

load_target_metadata() {
  local package="$1"
  local install_dir="$packages_dir/$package/system-install"
  local manifest="$packages_dir/$package/system-install.manifest"
  local line rel_path mode owner group extra normalized_mode
  local line_no=0
  typeset -gA target_modes target_owners target_groups
  target_modes=()
  target_owners=()
  target_groups=()

  [[ -f "$manifest" ]] || die "missing system install manifest: $manifest"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue

    rel_path=""
    mode=""
    owner=""
    group=""
    extra=""
    read -r rel_path mode owner group extra <<< "$line"

    [[ -n "$rel_path" && -n "$mode" && -n "$owner" && -n "$group" && -z "$extra" ]] ||
      die "invalid manifest line $manifest:$line_no"
    [[ "$rel_path" != /* && "$rel_path" != *../* && "$rel_path" != ../* && "$rel_path" != *.. ]] ||
      die "invalid manifest path $manifest:$line_no: $rel_path"
    [[ "$owner" =~ '^[A-Za-z_][A-Za-z0-9_-]*$|^[0-9]+$' ]] ||
      die "invalid manifest owner $manifest:$line_no: $owner"
    [[ "$group" =~ '^[A-Za-z_][A-Za-z0-9_-]*$|^[0-9]+$' ]] ||
      die "invalid manifest group $manifest:$line_no: $group"
    normalized_mode="$(normalize_mode "$mode")" ||
      die "invalid manifest mode $manifest:$line_no: $mode"
    [[ -z "${target_modes[$rel_path]-}" ]] ||
      die "duplicate manifest path $manifest:$line_no: $rel_path"
    [[ -f "$install_dir/$rel_path" ]] ||
      die "manifest path has no repo file $manifest:$line_no: $rel_path"
    [[ ! -L "$install_dir/$rel_path" ]] ||
      die "manifest path must not be a symlink $manifest:$line_no: $rel_path"
    is_protected_rel_path "$rel_path" &&
      die "refusing protected system path in manifest: $package $rel_path"

    target_modes[$rel_path]="$normalized_mode"
    target_owners[$rel_path]="$owner"
    target_groups[$rel_path]="$group"
  done < "$manifest"
}

collect_package_files() {
  local package="$1"
  local install_dir="$packages_dir/$package/system-install"
  local source rel_path
  typeset -ga package_sources package_rel_paths package_modes package_owners package_groups
  package_sources=()
  package_rel_paths=()
  package_modes=()
  package_owners=()
  package_groups=()

  load_target_metadata "$package"

  [[ ! -L "$install_dir" ]] || die "system-install must not be a symlink: $package"

  for source in "$install_dir"/**/*(DN.); do
    rel_path="${source#$install_dir/}"
    # A manifest-declared file is always collected, even when its basename matches
    # a meta pattern (e.g. an intentionally-installed /etc/skel/.gitignore).
    # is_meta_file only lets a package carry *undeclared* git/stow hygiene files
    # (a repo .gitignore, .stow-local-ignore, ...) without tripping the
    # "missing manifest entry" guard below; skipping a *declared* meta file here
    # would silently drop it from install/uninstall and diverge the live system
    # from system-install.manifest.
    if [[ -z "${target_modes[$rel_path]-}" ]] && is_meta_file "$rel_path"; then
      continue
    fi
    if is_protected_rel_path "$rel_path"; then
      die "refusing protected system path in repo package: $package $rel_path"
    fi
    [[ -n "${target_modes[$rel_path]-}" ]] ||
      die "missing manifest entry for system file: $package $rel_path"
    package_sources+=("$source")
    package_rel_paths+=("$rel_path")
    package_modes+=("${target_modes[$rel_path]}")
    package_owners+=("${target_owners[$rel_path]}")
    package_groups+=("${target_groups[$rel_path]}")
  done
}

install_selected_files() {
  local source rel_path dest mode owner group
  local i

  for (( i = 1; i <= ${#batch_sources[@]}; i++ )); do
    source="${batch_sources[$i]}"
    rel_path="${batch_rel_paths[$i]}"
    mode="${batch_modes[$i]}"
    owner="${batch_owners[$i]}"
    group="${batch_groups[$i]}"
    dest="/$rel_path"
    if sudo -n test -L "$dest" 2>/dev/null; then
      die "refusing to overwrite symlink at system destination: $dest"
    fi
    (( verbose )) && print -- "install -D -m $mode -o $owner -g $group -- $source $dest"
    sudo -n install -D -T -m "$mode" -o "$owner" -g "$group" -- "$source" "$dest"
  done
}

validate_uninstall_batch() {
  sudo -n -v || die "sudo session expired before uninstall validation; re-run to refresh"
  local source rel_path dest
  local i
  for (( i = 1; i <= ${#batch_sources[@]}; i++ )); do
    source="${batch_sources[$i]}"
    rel_path="${batch_rel_paths[$i]}"
    dest="/$rel_path"
    { sudo -n test -e "$dest" || sudo -n test -L "$dest"; } || continue
    if ! sudo -n test -f "$dest" || sudo -n test -L "$dest"; then
      print -u2 -- "not ok - refusing to remove non-regular or symlinked system path: $dest"
      return 1
    fi
    if ! sudo -n cmp -s -- "$source" "$dest"; then
      print -u2 -- "not ok - refusing to remove drifted system path: $dest"
      return 1
    fi
  done
}

uninstall_selected_files() {
  local source rel_path dest
  local i

  for (( i = 1; i <= ${#batch_sources[@]}; i++ )); do
    source="${batch_sources[$i]}"
    rel_path="${batch_rel_paths[$i]}"
    dest="/$rel_path"

    if ! sudo -n test -e "$dest" && ! sudo -n test -L "$dest"; then
      (( verbose )) && print -- "skip missing: $dest"
      continue
    fi

    if ! sudo -n test -f "$dest" || sudo -n test -L "$dest"; then
      print -u2 -- "not ok - refusing to remove non-regular or symlinked system path: $dest"
      return 1
    fi

    if ! sudo -n cmp -s -- "$source" "$dest"; then
      print -u2 -- "not ok - refusing to remove drifted system path: $dest"
      return 1
    fi
  done

  for (( i = 1; i <= ${#batch_sources[@]}; i++ )); do
    rel_path="${batch_rel_paths[$i]}"
    dest="/$rel_path"

    if ! sudo -n test -e "$dest" && ! sudo -n test -L "$dest"; then
      continue
    fi

    (( verbose )) && print -- "rm -f -- $dest"
    sudo -n rm -f -- "$dest"
  done
}

verify_selected_files_installed_for_activation() {
  local source rel_path dest expected_mode expected_owner expected_group
  local actual_mode actual_owner actual_group owner_stat_format group_stat_format
  local i failures=0

  for (( i = 1; i <= ${#batch_sources[@]}; i++ )); do
    source="${batch_sources[$i]}"
    rel_path="${batch_rel_paths[$i]}"
    expected_mode="${batch_modes[$i]}"
    expected_owner="${batch_owners[$i]}"
    expected_group="${batch_groups[$i]}"
    dest="/$rel_path"
    owner_stat_format="%U"
    group_stat_format="%G"

    if ! sudo -n test -e "$dest" 2>/dev/null && ! sudo -n test -L "$dest" 2>/dev/null; then
      print -u2 -- "not ok - cannot activate because system path is missing: $dest"
      failures=$(( failures + 1 ))
      continue
    fi

    if ! sudo -n test -f "$dest" 2>/dev/null || sudo -n test -L "$dest" 2>/dev/null; then
      print -u2 -- "not ok - cannot activate because system path is not a regular file: $dest"
      failures=$(( failures + 1 ))
      continue
    fi

    if [[ "$expected_owner" =~ '^[0-9]+$' ]]; then
      owner_stat_format="%u"
    fi
    if [[ "$expected_group" =~ '^[0-9]+$' ]]; then
      group_stat_format="%g"
    fi

    actual_owner="$(sudo -n stat -c "$owner_stat_format" -- "$dest")" || {
      print -u2 -- "not ok - cannot stat system path owner before activation: $dest"
      failures=$(( failures + 1 ))
      continue
    }
    actual_group="$(sudo -n stat -c "$group_stat_format" -- "$dest")" || {
      print -u2 -- "not ok - cannot stat system path group before activation: $dest"
      failures=$(( failures + 1 ))
      continue
    }
    actual_mode="$(sudo -n stat -c '%a' -- "$dest")" || {
      print -u2 -- "not ok - cannot stat system path mode before activation: $dest"
      failures=$(( failures + 1 ))
      continue
    }

    if [[ "$actual_owner:$actual_group" != "$expected_owner:$expected_group" ]]; then
      print -u2 -- "not ok - cannot activate because system path owner/group differs from manifest: $dest"
      print -u2 -- "         expected: $expected_owner:$expected_group"
      print -u2 -- "         actual:   $actual_owner:$actual_group"
      failures=$(( failures + 1 ))
    fi

    if [[ "$actual_mode" != "$expected_mode" ]]; then
      print -u2 -- "not ok - cannot activate because system path mode differs from manifest: $dest"
      print -u2 -- "         expected: $expected_mode"
      print -u2 -- "         actual:   $actual_mode"
      failures=$(( failures + 1 ))
    fi

    if ! sudo -n cmp -s -- "$source" "$dest"; then
      print -u2 -- "not ok - cannot activate because system path content differs from repo: $dest"
      failures=$(( failures + 1 ))
    fi
  done

  if (( failures > 0 )); then
    die "activation requires installed system files to match this repo; run ./run.sh install $selector first"
  fi
}

collect_selected_files() {
  local package source rel_path
  local mode owner group
  typeset -ga batch_sources batch_rel_paths batch_modes batch_owners batch_groups
  batch_sources=()
  batch_rel_paths=()
  batch_modes=()
  batch_owners=()
  batch_groups=()
  typeset -A _seen=()

  for package in "${selected_packages[@]}"; do
    collect_package_files "$package"
    for rel_path in "${package_rel_paths[@]}"; do
      (( ${+_seen[$rel_path]} )) &&
        die "duplicate system destination /$rel_path: claimed by both '${_seen[$rel_path]}' and '$package'"
      _seen[$rel_path]="$package"
    done
    for source in "${package_sources[@]}"; do
      batch_sources+=("$source")
    done
    for rel_path in "${package_rel_paths[@]}"; do
      batch_rel_paths+=("$rel_path")
    done
    for mode in "${package_modes[@]}"; do
      batch_modes+=("$mode")
    done
    for owner in "${package_owners[@]}"; do
      batch_owners+=("$owner")
    done
    for group in "${package_groups[@]}"; do
      batch_groups+=("$group")
    done
  done

}

load_config_metadata() {
  local package="$1"
  local manifest="$packages_dir/$package/system-config.manifest"
  local line rel_path mode owner group extra normalized_mode
  local line_no=0
  typeset -gA config_modes config_owners config_groups
  config_modes=()
  config_owners=()
  config_groups=()

  [[ -f "$manifest" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue

    rel_path=""
    mode=""
    owner=""
    group=""
    extra=""
    read -r rel_path mode owner group extra <<< "$line"

    [[ -n "$rel_path" && -n "$mode" && -n "$owner" && -n "$group" && -z "$extra" ]] ||
      die "invalid system-config manifest line $manifest:$line_no"
    [[ "$rel_path" != /* && "$rel_path" != *../* && "$rel_path" != ../* ]] ||
      die "invalid system-config manifest path $manifest:$line_no: $rel_path"
    normalized_mode="$(normalize_mode "$mode")" ||
      die "invalid system-config manifest mode $manifest:$line_no: $mode"
    [[ -z "${config_modes[$rel_path]-}" ]] ||
      die "duplicate system-config manifest path $manifest:$line_no: $rel_path"
    is_protected_rel_path "$rel_path" &&
      die "refusing protected system path in config manifest: $package $rel_path"

    config_modes[$rel_path]="$normalized_mode"
    config_owners[$rel_path]="$owner"
    config_groups[$rel_path]="$group"
  done < "$manifest"
}

load_units_metadata() {
  local package="$1"
  local manifest="$packages_dir/$package/system-units.manifest"
  local line unit extra
  local line_no=0
  typeset -ga system_units
  system_units=()

  [[ -f "$manifest" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue
    unit=""
    extra=""
    read -r unit extra <<< "$line"
    [[ -n "$unit" && -z "$extra" ]] ||
      die "invalid system-units manifest line $manifest:$line_no"
    [[ "$unit" != */* ]] ||
      die "system-units manifest must list unit names, not paths $manifest:$line_no: $unit"
    [[ "$unit" != -* ]] ||
      die "system-units manifest unit must not start with '-': $manifest:$line_no: $unit"
    case "$unit" in
      *.service|*.timer|*.path|*.socket|*.mount|*.target) ;;
      *) die "unsupported unit type in system-units manifest $manifest:$line_no: $unit" ;;
    esac
    if is_template_unit_name "$unit" && [[ "$unit" != *.service ]]; then
      die "system-units manifest must list concrete template instances, not template units $manifest:$line_no: $unit"
    fi
    system_units+=("$unit")
  done < "$manifest"
}

is_template_unit_name() {
  local unit="$1"
  [[ "$unit" == *@.* && "${${unit%.*}#*@}" == "" ]]
}

template_unit_name_for_instance() {
  local unit="$1"
  if [[ "$unit" == *@*.* && "$unit" != *.mount ]] && ! is_template_unit_name "$unit"; then
    print -r -- "${unit%%@*}@.${unit##*.}"
  fi
}

systemd_directive_value() {
  local key="$1" file="$2" value
  value="$(
    grep -m1 "^[[:space:]]*${key}[[:space:]]*=" "$file" 2>/dev/null |
      sed "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//" || :
  )"
  value="${value%"${value##*[![:space:]]}"}"
  print -r -- "$value"
}

systemd_truthy_directive() {
  local key="$1" file="$2" value
  value="$(systemd_directive_value "$key" "$file")"
  value="${value%%#*}"
  value="${value%%;*}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  case "${(L)value}" in
    yes|true|1|on) return 0 ;;
  esac
  return 1
}

socket_accept_service_base() {
  local unit="$1" unit_file="$2" socket_base
  if is_template_unit_name "${unit_file:t}"; then
    print -r -- "${unit_file:t:r}"
  else
    socket_base="${unit%.socket}"
    print -r -- "${socket_base%%@*}@"
  fi
}

unit_has_install_section() {
  local unit_file="$1"
  grep -qE '^[[:space:]]*\[Install\]' "$unit_file" 2>/dev/null
}

resolve_unit_file_path() {
  local unit_dir="$1" unit="$2" unit_file template_file
  unit_file="$unit_dir/$unit"
  template_file="$(template_unit_name_for_instance "$unit")"
  if [[ ! -f "$unit_file" && -n "$template_file" ]]; then
    unit_file="$unit_dir/$template_file"
  fi
  print -r -- "$unit_file"
}

# systemd resolves an exact unit name against its whole system unit load path
# before ever falling back to a template, so a shadow check must be exhaustive
# across that path. Ask systemd itself rather than hard-coding a list (kept in
# parity with run.sh's system_unit_search_paths).
system_unit_search_paths() {
  command -v systemd-analyze >/dev/null 2>&1 ||
    die "systemd-analyze is required to determine the system unit search path"
  systemd-analyze unit-paths ||
    die "failed to query the system unit search path via systemd-analyze"
}

find_shadowing_system_unit_path() {
  local unit="$1" dir path
  for dir in "${(@f)$(system_unit_search_paths)}"; do
    path="$dir/$unit"
    if sudo -n test -e "$path" 2>/dev/null || sudo -n test -L "$path" 2>/dev/null; then
      print -r -- "$path"
      return 0
    fi
  done
  return 1
}

stop_system_template_instances() {
  local unit="$1"
  local pattern="${unit/@./@*.}"
  local line instance
  for line in "${(@f)$(sudo -n systemctl list-units --all --no-legend --plain -- "$pattern" 2>/dev/null)}"; do
    instance="${${(z)line}[1]}"
    [[ -n "$instance" ]] || continue
    print -- "Stopping $instance (Accept=yes connection instance of $unit)"
    sudo -n systemctl stop "$instance" || print -u2 -- "warning: failed to stop $instance (ignored)"
  done
}

systemd_unescape_instance() {
  local instance="$1"
  if [[ -n "$instance" ]] && command -v systemd-escape >/dev/null 2>&1; then
    systemd-escape --unescape -- "$instance"
  else
    print -r -- "$instance"
  fi
}

activation_bases_for_unit() {
  local unit_dir="$1" unit="$2"
  local unit_file managed_target unit_instance unit_instance_unescaped

  unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
  unit_instance=""
  [[ "$unit" == *@*.* ]] && unit_instance="${${unit%.*}#*@}"
  unit_instance_unescaped="$(systemd_unescape_instance "$unit_instance")"

  case "$unit" in
    *.timer|*.path)
      managed_target="$(systemd_directive_value Unit "$unit_file")"
      if [[ -n "$managed_target" ]]; then
        [[ -n "$unit_instance" ]] && managed_target="${managed_target//\%i/$unit_instance}"
        [[ -n "$unit_instance" ]] && managed_target="${managed_target//\%I/$unit_instance_unescaped}"
        print -r -- "${managed_target%.service}"
      else
        print -r -- "${unit%.*}"
      fi
      ;;
    *.socket)
      managed_target="$(systemd_directive_value Service "$unit_file")"
      if [[ -n "$managed_target" ]]; then
        [[ -n "$unit_instance" ]] && managed_target="${managed_target//\%i/$unit_instance}"
        [[ -n "$unit_instance" ]] && managed_target="${managed_target//\%I/$unit_instance_unescaped}"
        print -r -- "${managed_target%.service}"
      elif systemd_truthy_directive Accept "$unit_file"; then
        # Accept=yes sockets instantiate the template service per connection;
        # they never start the plain, non-template foo.service.
        print -r -- "$(socket_accept_service_base "$unit" "$unit_file")"
      else
        print -r -- "${unit%.socket}"
      fi
      ;;
  esac
}

batch_has_units() {
  local package
  for package in "${selected_packages[@]}"; do
    [[ -f "$packages_dir/$package/system-units.manifest" ]] && return 0
  done
  return 1
}

prompt_path() {
  local prompt="$1"
  local answer=""

  [[ -r /dev/tty && -w /dev/tty ]] || die "interactive config prompt requires a TTY"
  printf '%s: ' "$prompt" > /dev/tty
  IFS= read -r answer < /dev/tty
  print -r -- "$answer"
}

# Validates config manifest entries for root ownership and root-only modes before any files are copied.
pre_validate_config_manifest() {
  local package="$1"
  local manifest="$packages_dir/$package/system-config.manifest"
  local line rel_path mode owner group extra nm
  local line_no=0
  [[ -f "$manifest" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue
    rel_path="" mode="" owner="" group="" extra=""
    read -r rel_path mode owner group extra <<< "$line"
    [[ -n "$rel_path" && -n "$mode" && -n "$owner" && -n "$group" && -z "$extra" ]] ||
      die "invalid system-config manifest line $manifest:$line_no"
    [[ "$owner" == "root" || "$owner" == "0" ]] ||
      die "system-config.manifest entry must be root-owned: $package $rel_path (got $owner)"
    nm="$(normalize_mode "$mode")" ||
      die "invalid mode in system-config.manifest: $package $rel_path: $mode"
    (( (8#$nm & 8#7077) == 0 )) ||
      die "system-config.manifest entry must be root-only mode with no set-id/sticky bits: $package $rel_path (mode $mode)"
  done < "$manifest"
}

# Copies a secret config WITHOUT reading its contents (install does the byte copy).
process_package_configs() {
  local package="$1"
  local rel_path dest dest_parent src mode owner group

  load_config_metadata "$package"
  (( ${#config_modes[@]} > 0 )) || return 0

  for rel_path in "${(@k)config_modes}"; do
    dest="/$rel_path"
    mode="${config_modes[$rel_path]}"
    owner="${config_owners[$rel_path]}"
    group="${config_groups[$rel_path]}"

    if sudo -n test -e "$dest" || sudo -n test -L "$dest"; then
      { sudo -n test -f "$dest" && ! sudo -n test -L "$dest"; } ||
        die "config path exists but is not a regular file: $dest"
      local existing_uid existing_mode
      existing_uid="$(sudo -n stat -c '%u' -- "$dest")" || die "cannot stat config owner: $dest"
      existing_mode="$(sudo -n stat -c '%a' -- "$dest")" || die "cannot stat config mode: $dest"
      [[ "$existing_uid" == "0" ]] ||
        die "existing config is not root-owned: $dest (fix: sudo chown root:root $dest && sudo chmod 600 $dest)"
      (( (8#$existing_mode & 8#7077) == 0 )) ||
        die "existing config has insecure permissions (group/world or set-id/sticky bits): $dest (fix: sudo chmod 600 $dest)"
      print -- "Detected existing config (left as-is): $dest"
      continue
    fi

    [[ "$owner" == "root" || "$owner" == "0" ]] ||
      die "refusing to install secret config with non-root owner: $dest (manifest owner: $owner; system-config.manifest entries must be root-owned)"

    (( (8#$mode & 8#7077) == 0 )) ||
      die "refusing to install secret config with group/world-readable or set-id/sticky mode: $dest (mode $mode; fix the manifest entry to use 0600 or 0400)"

    print -- "Package '$package' needs a root-only config at: $dest ($owner:$group mode $mode)"
    src="$(prompt_path "Path to source config for $dest (enter path, empty = sudoedit, 'skip' = defer to later)")"

    if [[ "$src" == "skip" ]]; then
      print -u2 -- "warning - skipping config: $dest (run './run.sh activate $package' after creating it)"
      # Plain assignment, not (( configs_missing++ )): under set -e a zsh
      # arithmetic command whose value is 0 (the post-increment result on the
      # first skip) returns status 1 and would abort the whole install.
      configs_missing=$(( configs_missing + 1 ))
      continue
    fi

    if [[ -z "$src" ]]; then
      print -- "Creating $dest in place with sudoedit (contents never copied)..."
      dest_parent="${dest:h}"
      sudo -n mkdir -p -- "$dest_parent" ||
        die "cannot create config parent directory: $dest_parent"
      sudo -e -- "$dest" || die "sudoedit cancelled or failed for $dest"
      sudo -n test -f "$dest" || die "config was not saved: $dest"
      sudo -n chmod "$mode" "$dest" || die "cannot set mode on $dest"
      sudo -n chown "$owner:$group" "$dest" || die "cannot set owner on $dest"
      continue
    fi

    [[ -f "$src" && ! -L "$src" ]] || die "config source must be a regular non-symlink file: $src"
    [[ -s "$src" ]] || die "config source is empty: $src"
    print -- "Installing config to $dest (root-only; contents are not read by this script)"
    sudo -n install -D -m "$mode" -o "$owner" -g "$group" -- "$src" "$dest"
  done
}

require_configs_present() {
  local package="$1"
  local rel_path dest uid mode

  load_config_metadata "$package"
  (( ${#config_modes[@]} > 0 )) || return 0

  for rel_path in "${(@k)config_modes}"; do
    dest="/$rel_path"
    { sudo -n test -f "$dest" && ! sudo -n test -L "$dest"; } ||
      die "cannot activate $package: required config missing or not a regular file: $dest (create it, e.g. sudoedit $dest)"
    uid="$(sudo -n stat -c '%u' -- "$dest")" || die "cannot stat config owner: $dest"
    mode="$(sudo -n stat -c '%a' -- "$dest")" || die "cannot stat config mode: $dest"
    [[ "$uid" == "0" ]] || die "config must be owned by root: $dest"
    (( (8#$mode & 8#7077) == 0 )) || die "config must be root-only with no set-id/sticky bits, for example mode 0600: $dest"
  done
}

activate_units() {
  local package="$1"
  local unit unit_file unit_dir dest_name base instance_path
  local verify_failures=0
  local -A activation_bases    # service bases that should not be started directly
  local -A timer_managed_bases # subset owned by a .timer (safe to defer-start)
  local -a deferred_oneshots   # timer-managed oneshots started after triggers are enabled

  load_units_metadata "$package"
  (( ${#system_units[@]} > 0 )) || return 0
  command -v systemctl >/dev/null 2>&1 || die "systemctl is required to activate units for $package"

  unit_dir="$packages_dir/$package/system-install/etc/systemd/system"
  for unit in "${system_units[@]}"; do
    unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
    # System unit files are plain-copied (not stow-symlinked), and content/
    # mode/owner identity for units this package actually ships is already
    # guaranteed before this runs. The one case that isn't covered: a
    # concrete instance (foo@bar.timer) this package does NOT ship, backed
    # only by a template (foo@.timer). systemd's unit search prefers an
    # exact instance file over the template across its whole unit load path,
    # so a stale/foreign file anywhere on that path would silently shadow the
    # packaged template when we enable/restart "$unit" by name below.
    dest_name="${unit_file:t}"
    if [[ "$dest_name" != "$unit" ]]; then
      if instance_path="$(find_shadowing_system_unit_path "$unit")"; then
        print -u2 -- "not ok - stale exact-instance unit shadows template: $instance_path"
        verify_failures=$(( verify_failures + 1 ))
      fi
    fi
    for base in "${(@f)$(activation_bases_for_unit "$unit_dir" "$unit")}"; do
      [[ -n "$base" ]] || continue
      activation_bases[$base]=1
      [[ "$unit" == *.timer ]] && timer_managed_bases[$base]=1
    done
  done

  (( verify_failures == 0 )) ||
    die "cannot activate $package: $verify_failures system unit stale-instance shadow failure(s)"

  print -- "Reloading systemd manager for $package units"
  sudo -n systemctl daemon-reload ||
    die "failed to reload systemd manager for $package"
  for unit in "${system_units[@]}"; do
    case "$unit" in
      *.timer)
        # Trigger unit: enable only when installable, then restart so a
        # changed unit file's config is applied with one start transition.
        unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
        if unit_has_install_section "$unit_file"; then
          print -- "Enabling $unit"
          sudo -n systemctl enable "$unit"
        fi
        print -- "Restarting $unit"
        sudo -n systemctl restart "$unit"
        ;;
      *.path|*.socket)
        # Trigger units: start, and enable only when installable. Unlike
        # timers, restarting an already-active socket/path tears down its live
        # fd/watch, so activation is intentionally start-only.
        unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
        if unit_has_install_section "$unit_file"; then
          print -- "Enabling $unit"
          sudo -n systemctl enable "$unit"
        fi
        print -- "Starting $unit"
        sudo -n systemctl start "$unit"
        ;;
      *.service)
        if [[ -n "${activation_bases[${unit%.service}]+x}" ]]; then
          # enable --now on a timer starts only the timer, so a timer-managed
          # oneshot would produce no result until the first tick. Such a oneshot
          # is run once so activation ends in a defined state — but only after
          # every trigger unit is activated, and non-fatally (see the
          # deferred_oneshots loop below), so a transient failure cannot abort
          # activation with its timer still disabled. A socket/path-managed
          # service must instead start from its activation context (the live
          # connection/watch), so starting it here would run it prematurely or
          # fail; those, and long-running services, stay trigger-managed (skipped).
          # Use the shared directive parser, not an exact-line grep: systemd
          # treats whitespace around '=' and leading indentation as insignificant
          # (systemd.syntax), so `Type = oneshot` or an indented line must still
          # be recognized, otherwise the promised initial run is missed.
          unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
          if [[ -n "${timer_managed_bases[${unit%.service}]+x}" &&
                "$(systemd_directive_value Type "$unit_file")" == oneshot ]]; then
            deferred_oneshots+=("$unit")
          else
            print -- "Skipping $unit (managed by a socket, path, or timer unit)"
          fi
        else
          # A standalone system service that ships an [Install] section wants
          # to persist across boots, so enable it (creating its .wants link) as
          # well as running it; --now also runs it once, which for a oneshot
          # applies its policy immediately. Services without an [Install]
          # section are one-shot-at-activation and are only started.
          unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
          if unit_has_install_section "$unit_file"; then
            print -- "Enabling and starting $unit"
            sudo -n systemctl enable --now "$unit"
          else
            print -- "Starting $unit"
            sudo -n systemctl start "$unit"
          fi
        fi
        ;;
      *.target|*.mount)
        if [[ -n "${activation_bases[$unit]+x}" ]]; then
          print -- "Skipping $unit (managed by a timer unit)"
        else
          unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
          if unit_has_install_section "$unit_file"; then
            print -- "Enabling and starting $unit"
            sudo -n systemctl enable --now "$unit"
          else
            print -- "Starting $unit"
            sudo -n systemctl start "$unit"
          fi
        fi
        ;;
    esac
  done

  for unit in "${deferred_oneshots[@]}"; do
    print -- "Starting $unit once at activation (timer-managed oneshot)"
    sudo -n systemctl start "$unit" ||
      print -u2 -- "warning: initial run of $unit failed; its timer is enabled and will retry"
  done
}

deactivate_units() {
  local package="$1"
  local unit unit_file unit_dir dest_name base instance_path
  local -A activation_bases

  load_units_metadata "$package"
  (( ${#system_units[@]} > 0 )) || return 0
  command -v systemctl >/dev/null 2>&1 || die "systemctl is required to deactivate units for $package"

  unit_dir="$packages_dir/$package/system-install/etc/systemd/system"
  for unit in "${system_units[@]}"; do
    for base in "${(@f)$(activation_bases_for_unit "$unit_dir" "$unit")}"; do
      [[ -n "$base" ]] && activation_bases[$base]=1
    done
  done

  # Disable/stop trigger units first so they stop spawning their targets, then
  # tear down the remaining units in reverse declaration order (${(Oa)...} is
  # a plain index-order reversal, not an alphabetical sort) to respect
  # dependencies. Kept in parity with deactivate_user_units in run.sh.
  for unit in "${system_units[@]}"; do
    case "$unit" in
      *.timer|*.path|*.socket) ;;
      *) continue ;;
    esac
    # A package that only ships a unit's template (foo@.timer) doesn't own
    # the exact instance path; a stale/foreign file living anywhere on the
    # unit load path must not be disabled/stopped by name, mirroring the
    # activation-time shadow check.
    unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
    dest_name="${unit_file:t}"
    if [[ "$dest_name" != "$unit" ]]; then
      if instance_path="$(find_shadowing_system_unit_path "$unit")"; then
        print -u2 -- "warning: skipping deactivation of $unit: stale exact-instance unit shadows template: $instance_path"
        continue
      fi
    fi
    if unit_has_install_section "$unit_file"; then
      print -- "Disabling and stopping $unit"
      sudo -n systemctl disable --now "$unit" || print -u2 -- "warning: failed to disable $unit (ignored)"
    else
      print -- "Stopping $unit"
      sudo -n systemctl stop "$unit" || print -u2 -- "warning: failed to stop $unit (ignored)"
    fi
  done
  for unit in "${(Oa)system_units[@]}"; do
    case "$unit" in
      *.timer|*.path|*.socket) continue ;;
    esac
    unit_file="$(resolve_unit_file_path "$unit_dir" "$unit")"
    dest_name="${unit_file:t}"
    if [[ "$dest_name" != "$unit" ]]; then
      if instance_path="$(find_shadowing_system_unit_path "$unit")"; then
        print -u2 -- "warning: skipping deactivation of $unit: stale exact-instance unit shadows template: $instance_path"
        continue
      fi
    fi
    case "$unit" in
      *.target|*.mount)
        if [[ -n "${activation_bases[$unit]+x}" ]]; then
          print -- "Stopping $unit"
          sudo -n systemctl stop "$unit" || print -u2 -- "warning: failed to stop $unit (ignored)"
        elif unit_has_install_section "$unit_file"; then
          print -- "Disabling and stopping $unit"
          sudo -n systemctl disable --now "$unit" || print -u2 -- "warning: failed to disable/stop $unit (ignored)"
        else
          print -- "Stopping $unit"
          sudo -n systemctl stop "$unit" || print -u2 -- "warning: failed to stop $unit (ignored)"
        fi
        ;;
      *)
        is_template_unit_name "$unit" && {
          stop_system_template_instances "$unit"
          print -- "Skipping $unit (template service managed by an Accept=yes socket)"
          continue
        }
        # Symmetric with activate_units: only a *standalone* service that ships an
        # [Install] section was enabled at activation, so disable it here. A
        # trigger-managed service (timer/path/socket) was never enabled by this
        # tool — it was skipped or its timer defer-started it — so only stop it;
        # disabling could strip an enablement created outside this tool. A
        # service without [Install] was only started, so likewise just stop it.
        if [[ -z "${activation_bases[${unit%.service}]+x}" ]] && unit_has_install_section "$unit_file"; then
          print -- "Disabling and stopping $unit"
          sudo -n systemctl disable --now "$unit" || print -u2 -- "warning: failed to disable/stop $unit (ignored)"
        else
          print -- "Stopping $unit"
          sudo -n systemctl stop "$unit" || print -u2 -- "warning: failed to stop $unit (ignored)"
        fi
        ;;
    esac
  done
}

(( $# >= 2 )) || {
  usage
  exit 64
}

action="$1"
shift
selector=""
verbose=0

case "$action" in
  install|uninstall|activate) ;;
  *)
    usage
    exit 64
    ;;
esac

while (( $# > 0 )); do
  case "$1" in
    --verbose|-v)
      [[ "$action" != "activate" ]] || die "--verbose is not supported for activate"
      verbose=1
      ;;
    --)
      shift
      (( $# == 1 )) || {
        usage
        exit 64
      }
      [[ -z "$selector" ]] || {
        usage
        exit 64
      }
      selector="$1"
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [[ -z "$selector" ]] || {
        usage
        exit 64
      }
      selector="$1"
      ;;
  esac
  shift
done

[[ -n "$selector" ]] || {
  usage
  exit 64
}

select_packages "$selector"
if (( ${#selected_packages[@]} == 0 )); then
  print -- "No system packages selected for: $selector"
  exit 0
fi

command -v sudo >/dev/null 2>&1 || die "sudo is required for system copy-install"
command -v stat >/dev/null 2>&1 || die "stat is required"
if [[ "$action" == "install" ]]; then
  command -v install >/dev/null 2>&1 || die "install is required"
fi
command -v cmp >/dev/null 2>&1 || die "cmp is required"

# Fail fast on repo/manifest inconsistencies before touching the live system.
"$repo_root/scripts/check-repo" -- "${selected_packages[@]}"

load_protected_paths
collect_selected_files
start_sudo_session "System package changes require sudo. The password is requested once; later prompts are y/N decisions."

case "$action" in
  install)
    print -- "Installing system package(s): ${selected_packages[*]}"
    for package in "${selected_packages[@]}"; do
      pre_validate_config_manifest "$package"
    done
    if (( ${#batch_sources[@]} > 0 )); then
      if confirm_action "Copy selected system files to / using manifest ownership and modes?"; then
        install_selected_files
      else
        die "system install aborted before copying files"
      fi
    fi

    configs_missing=0
    for package in "${selected_packages[@]}"; do
      process_package_configs "$package"
    done

    if (( configs_missing > 0 )); then
      print -u2 -- "warning - some required config(s) were skipped; services were not activated."
      print -u2 -- "warning - create the missing config(s) shown above, then run: ./run.sh activate <package>"
    elif batch_has_units; then
      if confirm_action "Activate services for: ${selected_packages[*]} now?"; then
        for package in "${selected_packages[@]}"; do
          activate_units "$package"
        done
      else
        print -- "Skipped activation. Run later: ./run.sh activate <package>"
      fi
    fi
    ;;
  uninstall)
    print -- "Uninstalling system package(s): ${selected_packages[*]}"
    confirm_action "Remove matching system files from /?" ||
      die "system uninstall aborted before removing files"
    validate_uninstall_batch ||
      die "uninstall aborted: drift or unexpected state detected"
    for package in "${selected_packages[@]}"; do
      deactivate_units "$package"
    done
    uninstall_selected_files
    if batch_has_units; then
      sudo -n systemctl daemon-reload ||
        print -u2 -- "warning: systemctl daemon-reload failed after uninstall"
    fi
    ;;
  activate)
    print -- "Activating system package service(s): ${selected_packages[*]}"
    verify_selected_files_installed_for_activation
    for package in "${selected_packages[@]}"; do
      require_configs_present "$package"
    done
    for package in "${selected_packages[@]}"; do
      activate_units "$package"
    done
    ;;
esac
