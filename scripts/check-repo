#!/usr/bin/env zsh
emulate -L zsh
set -euo pipefail

# Static consistency linter for package declarations.
# Verifies (without sudo, without touching the live system):
#   - every system-install file is declared in system-install.manifest (and vice versa),
#   - every installed systemd unit is declared in system-units.manifest,
#   - every *.example config has its real destination declared in system-config.manifest,
#   - no real (non-.example) secret config is committed in the repo,
#   - every user systemd unit is declared in user-units.manifest (and vice versa),
#   - only the allowed *.hook.sh files exist, are executable, and contain no sudo.
#
# Usage: check-repo [--] [<package> ...]   (no package = check all)

script_name="${0:t}"
repo_root="${0:A:h:h}"
packages_dir="$repo_root/packages"

errors=0
allowed_hooks=(install.hook.sh uninstall.hook.sh verify.hook.sh)
protected_paths_file="$repo_root/manifests/protected-system-paths.txt"
typeset -a protected_paths
protected_paths=()

allow_setid_file="$repo_root/manifests/allow-setid-system-paths.txt"
typeset -gA allow_setid_paths
allow_setid_paths=()

_load_protected_paths() {
  local line
  [[ -f "$protected_paths_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    protected_paths+=("$line")
  done < "$protected_paths_file"
}

# Paths explicitly opted-in (exact match, repo-relative, no leading slash) to carry a
# setuid/setgid/sticky bit in system-install.manifest.
_load_allow_setid_paths() {
  local line
  [[ -f "$allow_setid_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    allow_setid_paths[$line]=1
  done < "$allow_setid_file"
}

_is_protected_rel_path() {
  local rel_path="$1" pattern
  for pattern in "${protected_paths[@]}"; do
    [[ "$rel_path" == ${~pattern} ]] && return 0
  done
  return 1
}

err() {
  print -u2 -- "$script_name: ERROR: $*"
  errors=$(( errors + 1 ))
}

is_meta_file() {
  local rel="$1"
  # Files Stow ignores and never links (mirror scripts/stow-select --ignore):
  # git metadata and stow markers a package may carry without being installed.
  # Kept logically identical to is_install_meta_file in run.sh.
  case "$rel" in
    .gitkeep|*/.gitkeep|.stow-local-ignore|*/.stow-local-ignore) return 0 ;;
    .gitignore|*/.gitignore|.gitattributes|*/.gitattributes|.gitmodules|*/.gitmodules) return 0 ;;
    .git/*|*/.git/*) return 0 ;;
  esac
  return 1
}

# Filenames GNU Stow silently drops at install time. A package must not ship
# such junk: stow skips it (no link), then `./run.sh verify`/`test` enumerate it
# from install/ and report a missing stow link. Keep this in sync with the
# `--ignore` list in scripts/stow-select (junk subset only; the git-infra
# entries and .gitkeep/.stow-local-ignore are legitimate meta, see is_meta_file).
is_stow_ignored() {
  local rel="$1" base="${rel:t}"
  case "$rel" in
    __pycache__/*|*/__pycache__/*) return 0 ;;
    .pytest_cache/*|*/.pytest_cache/*) return 0 ;;
    .mypy_cache/*|*/.mypy_cache/*) return 0 ;;
    .ruff_cache/*|*/.ruff_cache/*) return 0 ;;
    .tox/*|*/.tox/*) return 0 ;;
    .nox/*|*/.nox/*) return 0 ;;
  esac
  case "$base" in
    __pycache__|.pytest_cache|.mypy_cache|.ruff_cache|.tox|.nox) return 0 ;;
    *.pyc|*.pyo) return 0 ;;
    .DS_Store|Thumbs.db) return 0 ;;
    *~) return 0 ;;
    *.swp|*.swo|*.swx) return 0 ;;
    .#*) return 0 ;;
    \#*\#) return 0 ;;
  esac
  return 1
}

load_4col_manifest() {
  local manifest="$1" line rel_path mode owner group extra
  local line_no=0
  typeset -gA manifest_paths manifest_modes
  manifest_paths=()
  manifest_modes=()
  [[ -f "$manifest" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue
    rel_path="" mode="" owner="" group="" extra=""
    read -r rel_path mode owner group extra <<< "$line"
    if [[ -z "$rel_path" || -z "$mode" || -z "$owner" || -z "$group" || -n "$extra" ]]; then
      err "invalid manifest row (expected: path mode owner group) at $manifest:$line_no"
      continue
    fi
    if [[ "$rel_path" == /* || "$rel_path" == *../* || "$rel_path" == ../* || "$rel_path" == *.. ]]; then
      err "invalid manifest path (absolute or traversal) at $manifest:$line_no: $rel_path"
      continue
    fi
    # Reject non-canonical paths: a redundant separator (//) or ./ segment
    # normalizes away at install time, so the raw string would slip past the
    # protected-path check (which matches the literal spelling) while the real
    # destination lands on a protected path. Keep the manifest spelling canonical.
    if [[ "$rel_path" == *//* || "$rel_path" == */./* || "$rel_path" == ./* || "$rel_path" == */. ]]; then
      err "invalid manifest path (redundant separator or ./ segment) at $manifest:$line_no: $rel_path"
      continue
    fi
    if ! [[ "$mode" =~ '^[0-7]{3,4}$' ]]; then
      err "invalid mode '$mode' at $manifest:$line_no"
      continue
    fi
    if ! [[ "$owner" =~ '^[A-Za-z_][A-Za-z0-9_-]*$|^[0-9]+$' ]]; then
      err "invalid owner '$owner' at $manifest:$line_no"
      continue
    fi
    if ! [[ "$group" =~ '^[A-Za-z_][A-Za-z0-9_-]*$|^[0-9]+$' ]]; then
      err "invalid group '$group' at $manifest:$line_no"
      continue
    fi
    if [[ -n "${manifest_paths[$rel_path]-}" ]]; then
      err "duplicate manifest entry '$rel_path' at $manifest:$line_no"
      continue
    fi
    manifest_paths[$rel_path]=1
    manifest_modes[$rel_path]=$mode
  done < "$manifest"
}

_check_config_manifest_security() {
  local manifest="$1" package="$2" line rel_path mode owner group extra
  local line_no=0
  [[ -f "$manifest" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue
    rel_path="" mode="" owner="" group="" extra=""
    read -r rel_path mode owner group extra <<< "$line"
    [[ -n "$rel_path" && -n "$mode" && -n "$owner" && -n "$group" && -z "$extra" ]] || continue
    [[ "$owner" == "root" || "$owner" == "0" ]] ||
      err "$package: system-config.manifest entry must be root-owned: $rel_path (got: $owner)"
    [[ "$mode" =~ '^[0-7]{3,4}$' ]] || continue
    (( (8#$mode & 8#077) == 0 )) ||
      err "$package: system-config.manifest entry must have root-only mode (no group/world bits): $rel_path (got: $mode)"
    # Configs have no allow-list (unlike system-install.manifest), so set-id/
    # sticky bits are always rejected: they would install a user-supplied source
    # as a setuid/setgid-root file via process_package_configs.
    (( (8#$mode & 8#7000) == 0 )) ||
      err "$package: system-config.manifest entry must not use set-id/sticky bits: $rel_path (got: $mode)"
  done < "$manifest"
}

load_units_manifest() {
  local manifest="$1" kind="$2" line unit extra
  local line_no=0
  typeset -gA manifest_paths
  manifest_paths=()
  case "$kind" in
    system|user) ;;
    *) die "internal: load_units_manifest called with invalid kind: $kind" ;;
  esac
  [[ -f "$manifest" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$(( line_no + 1 ))
    [[ -z "$line" || "$line" == \#* ]] && continue
    unit="" extra=""
    read -r unit extra <<< "$line"
    if [[ -z "$unit" || -n "$extra" ]]; then
      err "invalid manifest row (expected: unit-name) at $manifest:$line_no"
      continue
    fi
    if [[ "$unit" == */* ]]; then
      err "unit name must not contain a slash at $manifest:$line_no: $unit"
      continue
    fi
    if [[ "$unit" == -* ]]; then
      err "unit name must not start with '-' at $manifest:$line_no: $unit"
      continue
    fi
    if [[ "$unit" == *%* ]]; then
      err "unit names must not contain literal specifiers at $manifest:$line_no: $unit"
      continue
    fi
    case "$unit" in
      *.mount)
        if [[ "$kind" == user ]]; then
          err "user unit manifest must not declare a mount unit (systemd.mount(5) requires UID 0): $manifest:$line_no: $unit"
          continue
        fi
        ;;
      *.service|*.timer|*.path|*.socket|*.target) ;;
      *)
        err "unsupported unit suffix at $manifest:$line_no: $unit"
        continue
        ;;
    esac
    if is_template_unit_name "$unit" && [[ "$unit" != *.service ]]; then
      err "manifest must list concrete template instances, not template units at $manifest:$line_no: $unit"
      continue
    fi
    if [[ -n "${manifest_paths[$unit]-}" ]]; then
      err "duplicate unit '$unit' at $manifest:$line_no"
      continue
    fi
    manifest_paths[$unit]=1
  done < "$manifest"
}

is_template_unit_name() {
  local unit="$1"
  [[ "$unit" == *@.* && "${${unit%.*}#*@}" == "" ]]
}

template_unit_name_for_instance() {
  local unit="$1"
  if [[ "$unit" == *@*.* && "$unit" != *.mount ]] && ! is_template_unit_name "$unit"; then
    print -r -- "${unit%%@*}@.${unit##*.}"
  fi
}

unit_name_matches_template() {
  local unit="$1" template="$2"
  [[ "$unit" == "${template%%@.*}@"*".${template##*.}" ]]
}

systemd_directive_value() {
  local key="$1" file="$2" section
  case "$key:${file:e}" in
    Unit:timer) section=Timer ;;
    Unit:path) section=Path ;;
    Service:socket|Accept:socket) section=Socket ;;
    Type:service) section=Service ;;
    *) return 2 ;;
  esac
  # Parse logical lines before recognizing sections. Contract directives must
  # be unambiguous scalars; unrelated continuations cannot forge a header.
  LC_ALL=C awk -v wanted="$key" -v expected="$section" '
    function trim(value) {
      sub(/^[ \t\r]+/, "", value); sub(/[ \t\r]+$/, "", value)
      return value
    }
    function consume(value, joined, key, position) {
      value = trim(value)
      if (substr(value, 1, 1) == "[") {
        if (value !~ /^\[[^][]+\]$/) { bad = 1; return }
        section = substr(value, 2, length(value) - 2)
      } else if (section == expected && (position = index(value, "="))) {
        key = trim(substr(value, 1, position - 1))
        if (key == wanted || (expected == "Socket" && (key == "Service" || key == "Accept")) ||
            ((expected == "Timer" || expected == "Path") && key == "Unit")) {
          if (++seen[key] > 1 || joined) { bad = 1; return }
          values[key] = trim(substr(value, position + 1))
          if (key == "Accept" && tolower(values[key]) !~ /^(|1|yes|y|true|t|on|0|no|n|false|f|off)$/)
            bad = 1
        }
      }
    }
    {
      physical = $0
      sub(/\r$/, "", physical)
      if (index(physical, sprintf("%c", 0))) { bad = 1; exit 2 }
      if (trim(physical) ~ /^[#;]/) next
      if (index(physical, "\357\273\277")) {
        if (bom_seen || pending != "" || index(physical, "\357\273\277") != 1) { bad = 1; exit 2 }
        physical = substr(physical, 4); bom_seen = 1
      }
      value = pending physical
      if (length(value) > 1048576) { bad = 1; exit 2 }
      slashes = 0
      for (i = length(value); i > 0 && substr(value, i, 1) == "\\"; i--) slashes++
      if (slashes % 2) { pending = substr(value, 1, length(value) - 1) " "; continued = 1; next }
      consume(value, continued)
      pending = ""; continued = 0
    }
    END {
      if (pending != "") consume(pending, 1)
      if (bad) exit 2
      print values[wanted]
    }
  ' "$file"
}

systemd_target_specifiers_supported() {
  local unit="$1" value="$2" remainder
  remainder="${value//\%i/}"
  remainder="${remainder//\%I/}"
  [[ "$remainder" != *%* ]] || return 1
  [[ "$value" != *%[iI]* || "$unit" == *@*.* ]]
}

systemd_truthy_directive() {
  local key="$1" file="$2" value
  value="$(systemd_directive_value "$key" "$file")" || return 2
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  case "${(L)value}" in
    yes|y|true|t|1|on) return 0 ;;
  esac
  return 1
}

systemd_unescape_instance() {
  local instance="$1"
  if [[ -n "$instance" ]] && command -v systemd-escape >/dev/null 2>&1; then
    systemd-escape --unescape -- "$instance"
  else
    print -r -- "$instance"
  fi
}

repo_unit_file_exists() {
  local unit_dir="$1" unit="$2" template_file
  [[ -f "$unit_dir/$unit" ]] && return 0
  template_file="$(template_unit_name_for_instance "$unit")"
  if [[ -n "$template_file" ]]; then
    [[ -f "$unit_dir/$template_file" ]] && return 0
  fi
  return 1
}

socket_accept_service_unit() {
  local socket_base="$1"
  socket_base="${socket_base%.socket}"
  print -r -- "${socket_base%%@*}@.service"
}

# True when the manifest declares $1 exactly, or (when $1 is a real template
# name such as foo@.service) declares at least one instance foo@<inst>.service.
# Reads the caller's `unit_names` associative array (zsh dynamic scope).
manifest_declares_unit() {
  local want="$1" name
  [[ -n "${unit_names[$want]-}" ]] && return 0
  if is_template_unit_name "$want"; then
    for name in "${(@k)unit_names}"; do
      unit_name_matches_template "$name" "$want" && return 0
    done
  fi
  return 1
}

# Trigger targets require exact concrete names. Template-file coverage above
# does not select an instance, and Accept=yes uses its separate template gate.
manifest_declares_concrete_target() {
  local want="$1"
  is_template_unit_name "$want" && return 1
  [[ -n "${unit_names[$want]-}" ]]
}

# When $1 is a template unit file base (e.g. foo@.timer) and $2 is its
# Unit=/Service= directive value (which may contain the %i/%I specifier),
# verify the directive resolves to a manifest-declared unit for every
# manifest instance backed by this template, mirroring the %i/%I
# substitution activate_units/activate_user_units already do at install time.
# Reads the caller's `unit_names` and `package` (zsh dynamic scope).
check_template_directive_instances() {
  local file_base="$1" directive="$2" directive_name="$3" manifest_name="$4"
  local instance inst_suffix inst_suffix_unescaped resolved
  for instance in "${(@k)unit_names}"; do
    unit_name_matches_template "$instance" "$file_base" || continue
    inst_suffix="${${instance%.*}#*@}"
    inst_suffix_unescaped="$(systemd_unescape_instance "$inst_suffix")"
    resolved="${directive//\%i/$inst_suffix}"
    resolved="${resolved//\%I/$inst_suffix_unescaped}"
    manifest_declares_concrete_target "$resolved" ||
      err "$package: $file_base references $directive_name=$directive which resolves to $resolved for instance $instance, not in $manifest_name"
  done
}

check_directive_target() {
  local file_base="$1" directive="$2" directive_name="$3" manifest_name="$4"
  local inst_suffix inst_suffix_unescaped resolved
  if ! systemd_target_specifiers_supported "$file_base" "$directive"; then
    err "$package: unsupported target specifier in $file_base; only instance %i/%I are supported"
    return 0
  fi
  if [[ "$directive" == *%[iI]* && "$file_base" == *@*.* ]]; then
    if is_template_unit_name "$file_base"; then
      check_template_directive_instances "$file_base" "$directive" "$directive_name" "$manifest_name"
    else
      inst_suffix="${${file_base%.*}#*@}"
      inst_suffix_unescaped="$(systemd_unescape_instance "$inst_suffix")"
      resolved="${directive//\%i/$inst_suffix}"
      resolved="${resolved//\%I/$inst_suffix_unescaped}"
      manifest_declares_concrete_target "$resolved" ||
        err "$package: $file_base references $directive_name=$directive which resolves to $resolved, not in $manifest_name"
    fi
  else
    manifest_declares_concrete_target "$directive" ||
      err "$package: $file_base references $directive_name=$directive which is not in $manifest_name"
  fi
}

check_implicit_service_target() {
  local unit_dir="$1" base="$2" implicit_svc="$3" manifest_name="$4"
  if repo_unit_file_exists "$unit_dir" "$implicit_svc"; then
    manifest_declares_concrete_target "$implicit_svc" ||
      err "$package: $base implicitly requires $implicit_svc which is not in $manifest_name"
  else
    err "$package: $base implicitly requires $implicit_svc which has no repo unit file"
  fi
}

check_trigger_directives() {
  local unit_dir="$1" manifest_name="$2"
  local unit_type directive f base custom_target implicit_svc
  typeset -A directive_by_type
  directive_by_type=(timer Unit path Unit socket Service)

  # Type controls activation of timer-managed oneshots. Validate every
  # service here, including templates, before lifecycle code can mutate units.
  for f in "$unit_dir"/*.service(N.); do
    systemd_directive_value Type "$f" >/dev/null ||
      err "$package: invalid or ambiguous systemd contract in ${f:t}"
  done

  for unit_type in timer path socket; do
    directive="${directive_by_type[$unit_type]}"
    for f in "$unit_dir"/*.$unit_type(N.); do
      base="${f:t}"
      custom_target="$(systemd_directive_value "$directive" "$f")" || {
        err "$package: invalid or ambiguous systemd contract in $base"
        continue
      }
      if [[ -n "$custom_target" ]]; then
        if [[ "$unit_type" == "socket" ]]; then
          [[ "$custom_target" == *.service ]] ||
            err "$package: $base sets $directive=$custom_target which must reference a .service unit"
          systemd_truthy_directive Accept "$f" &&
            err "$package: $base sets Accept=yes together with $directive=$custom_target, which systemd does not support (Service= requires Accept=no)"
        fi
        check_directive_target "$base" "$custom_target" "$directive" "$manifest_name"
        continue
      fi

      if [[ "$unit_type" == "socket" ]] && systemd_truthy_directive Accept "$f"; then
        implicit_svc="$(socket_accept_service_unit "$base")"
        accept_service_templates[$implicit_svc]=1
        repo_unit_file_exists "$unit_dir" "$implicit_svc" ||
          err "$package: $base implicitly requires $implicit_svc which has no repo unit file"
        [[ -n "${unit_names[$implicit_svc]-}" ]] ||
          err "$package: $base implicitly requires $implicit_svc which is not in $manifest_name"
      elif is_template_unit_name "$base"; then
        check_template_directive_instances "$base" "${base%%@.*}@%i.service" "implicit $directive" "$manifest_name"
      else
        implicit_svc="${base%.*}.service"
        check_implicit_service_target "$unit_dir" "$base" "$implicit_svc" "$manifest_name"
      fi
    done
  done
}

check_hooks() {
  local package="$1"
  local pkg_dir="$packages_dir/$package"
  local f base hook ok

  for f in "$pkg_dir"/*.hook.sh(N); do
    base="${f:t}"
    ok=0
    for hook in "${allowed_hooks[@]}"; do
      [[ "$base" == "$hook" ]] && { ok=1; break; }
    done
    if (( ! ok )); then
      err "$package: unknown hook file (allowed: ${allowed_hooks[*]}): $base"
      continue
    fi
    if [[ -L "$f" || ! -f "$f" ]]; then
      err "$package: hook must be a regular file, not a symlink or other node: $base"
      continue
    fi
    [[ -x "$f" ]] || err "$package: hook is not executable: $base"
    if grep -nE '(^|[[:space:];&|(])(/usr/bin/|/bin/)?sudo([[:space:]]|$)' -- "$f" >/dev/null 2>&1; then
      err "$package: hook must not use sudo (user-level only): $base"
    fi
  done

  for f in "$pkg_dir"/*/**/*.hook.sh(ND.); do
    err "$package: hook must live in package root, not in any subdirectory: ${f#$pkg_dir/}"
  done
}

extract_function_block() {
  local file="$1" fn="$2"
  awk -v fn="$fn" '
    $0 == fn "() {" && !in_fn {
      in_fn = 1
      depth = 1
      print
      next
    }
    in_fn {
      print
      line = $0
      depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
      if (depth == 0) exit
    }
  ' "$file"
}

check_function_parity() {
  local left_file="$1" right_file="$2" fn="$3"
  local left_body right_body
  left_body="$(extract_function_block "$left_file" "$fn")"
  right_body="$(extract_function_block "$right_file" "$fn")"

  [[ -n "$left_body" ]] || { err "helper parity: missing $fn in ${left_file#$repo_root/}"; return 0; }
  [[ -n "$right_body" ]] || { err "helper parity: missing $fn in ${right_file#$repo_root/}"; return 0; }
  [[ "$left_body" == "$right_body" ]] ||
    err "helper parity: $fn differs between ${left_file#$repo_root/} and ${right_file#$repo_root/}"
}

# Like check_function_parity, but allows the two functions being compared to
# have different names and reference different variables, by applying a
# sed(1) normalization to each side before comparing.
check_function_parity_normalized() {
  local left_file="$1" right_file="$2" left_fn="$3" right_fn="$4"
  local left_sed="$5" right_sed="$6"
  local left_body right_body

  left_body="$(extract_function_block "$left_file" "$left_fn" | sed -e "$left_sed")"
  right_body="$(extract_function_block "$right_file" "$right_fn" | sed -e "$right_sed")"

  [[ -n "$left_body" ]] || { err "helper parity: missing $left_fn in ${left_file#$repo_root/}"; return 0; }
  [[ -n "$right_body" ]] || { err "helper parity: missing $right_fn in ${right_file#$repo_root/}"; return 0; }
  [[ "$left_body" == "$right_body" ]] ||
    err "helper parity: $left_fn (${left_file#$repo_root/}) differs from $right_fn (${right_file#$repo_root/}) modulo normalization"
}

check_helper_parity() {
  local run_script="$repo_root/run.sh"
  local system_script="$repo_root/scripts/system-copy-select"
  local check_script="$repo_root/scripts/check-repo"
  local fn

  for fn in \
    is_template_unit_name \
    template_unit_name_for_instance \
    systemd_directive_value \
    systemd_target_specifiers_supported \
    systemd_truthy_directive \
    systemd_unescape_instance; do
    check_function_parity "$run_script" "$system_script" "$fn"
    check_function_parity "$run_script" "$check_script" "$fn"
  done

  for fn in \
    socket_accept_service_base \
    unit_has_install_section \
    resolve_unit_file_path \
    activation_bases_for_unit; do
    check_function_parity "$run_script" "$system_script" "$fn"
  done

  check_function_parity_normalized "$run_script" "$check_script" \
    unit_set_declares_unit manifest_declares_unit \
    "s/unit_set_declares_unit/UNIT_DECLARES_UNIT/; s/unit_set/UNIT_MAP/g" \
    "s/manifest_declares_unit/UNIT_DECLARES_UNIT/; s/unit_names/UNIT_MAP/g"
}

# Classify complete standard system-manager load-directory families by path
# components, not by unit suffix: drop-ins and future unit types must not pass
# as ordinary system files. Do not query/execute the host or candidate code.
is_system_unit_load_path() {
  local rel="$1" index
  local -a components
  components=("${(@s:/:)rel}")
  for (( index=1; index<${#components}; index++ )); do
    [[ "${components[$index]}" == systemd ]] || continue
    case "${components[$(( index + 1 ))]}" in
      system|system.control|system.attached|transient|generator|generator.early|generator.late) return 0 ;;
    esac
  done
  return 1
}

check_system_unit_install_location() {
  local rel="$1" package="$2"
  local -a components
  is_system_unit_load_path "$rel" || return 0
  components=("${(@s:/:)rel}")
  if [[ "$rel" == etc/systemd/system/* && ${#components} == 4 ]]; then
    case "${rel:e}" in
      service|timer|path|socket|mount|target) return 0 ;;
    esac
  fi
  err "$package: unsupported system unit location or suffix: $rel"
}

check_system_layer() {
  local package="$1"
  local sys_dir="$packages_dir/$package/system-install"
  local install_manifest="$packages_dir/$package/system-install.manifest"
  local units_manifest="$packages_dir/$package/system-units.manifest"
  local config_manifest="$packages_dir/$package/system-config.manifest"
  local f rel base real_rel
  typeset -A install_paths install_modes config_paths unit_names accept_service_templates

  # Config-only packages still need destination validation even without a
  # system-install source tree.
  load_4col_manifest "$config_manifest"
  _check_config_manifest_security "$config_manifest" "$package"
  config_paths=("${(@kv)manifest_paths}")
  for rel in "${(@k)config_paths}"; do
    # Unit payloads must be reviewable source, never out-of-band secret data.
    is_system_unit_load_path "$rel" &&
      err "$package: system config destination must not be a system unit load path: $rel"
    _is_protected_rel_path "$rel" &&
      err "$package: protected system path in system-config.manifest: $rel"
  done


  [[ ! -L "$sys_dir" ]] || { err "$package: system-install must not be a symlink"; return 0; }
  [[ -d "$sys_dir" ]] || return 0

  if [[ ! -f "$install_manifest" ]]; then
    err "$package: has system-install/ but no system-install.manifest"
    return 0
  fi

  load_4col_manifest "$install_manifest"
  install_paths=("${(@kv)manifest_paths}")
  install_modes=("${(@kv)manifest_modes}")
  for rel in "${(@k)install_paths}"; do
    check_system_unit_install_location "$rel" "$package"
    _is_protected_rel_path "$rel" &&
      err "$package: protected system path in system-install.manifest: $rel"
    # set-id/sticky (octal 7000 bits) is a privilege-escalation primitive and
    # requires explicit opt-in in manifests/allow-setid-system-paths.txt.
    if (( (8#${install_modes[$rel]} & 8#7000) != 0 )); then
      [[ -n "${allow_setid_paths[$rel]-}" ]] ||
        err "$package: set-id/sticky mode ${install_modes[$rel]} on '$rel' requires an entry in manifests/allow-setid-system-paths.txt"
    fi
  done

  # Check 1: every system-install file is declared.
  for f in "$sys_dir"/**/*(DN.); do
    rel="${f#$sys_dir/}"
    is_meta_file "$rel" && continue
    is_stow_ignored "$rel" &&
      { err "$package: system-install file would be skipped by Stow (remove it): $rel"; continue; }
    [[ -n "${install_paths[$rel]-}" ]] || err "$package: system file not in system-install.manifest: $rel"
  done
  for f in "$sys_dir"/**/*(DN@); do
    rel="${f#$sys_dir/}"
    is_meta_file "$rel" && continue
    err "$package: system-install must not contain symlinks: $rel"
  done
  # Reverse: every manifest entry has a repo file.
  for rel in "${(@k)install_paths}"; do
    [[ -f "$sys_dir/$rel" ]] || err "$package: system-install.manifest entry has no repo file: $rel"
    [[ ! -L "$sys_dir/$rel" ]] || err "$package: system-install.manifest entry must not be a symlink: $rel"
  done

  # Check 2: every installed systemd unit is declared in system-units.manifest
  # (a template file satisfies any manifest entry that is an instance of it).
  load_units_manifest "$units_manifest" system
  unit_names=("${(@kv)manifest_paths}")
  accept_service_templates=()
  for f in "$sys_dir"/etc/systemd/system/*(N.); do
    base="${f:t}"
    case "$base" in
      *.service|*.timer|*.path|*.socket|*.mount|*.target)
        manifest_declares_unit "$base" ||
          err "$package: systemd unit not in system-units.manifest: $base"
        ;;
    esac
  done
  # Reverse: every manifest unit has a repo unit file (template instances resolve to their template file).
  for base in "${(@k)unit_names}"; do
    repo_unit_file_exists "$sys_dir/etc/systemd/system" "$base" ||
      err "$package: system-units.manifest entry has no repo unit file: $base"
  done

  check_trigger_directives "$sys_dir/etc/systemd/system" "system-units.manifest"
  for base in "${(@k)unit_names}"; do
    if is_template_unit_name "$base" && [[ "$base" == *.service && -z "${accept_service_templates[$base]-}" ]]; then
      err "$package: template service in system-units.manifest must be required by an Accept=yes socket: $base"
    fi
  done


  # Check 3: every *.example config maps to a declared real destination.
  for f in "$sys_dir"/**/*.example(DN.); do
    rel="${f#$sys_dir/}"
    real_rel="${rel%.example}"
    [[ -n "${config_paths[$real_rel]-}" ]] ||
      err "$package: example config without system-config.manifest entry for real dest: $real_rel (from $rel)"
  done

  # Check 4: a real (non-.example) secret config must never be committed.
  for rel in "${(@k)config_paths}"; do
    [[ -e "$sys_dir/$rel" ]] &&
      err "$package: secret config must not be committed; found real file: system-install/$rel"
  done
}

check_user_layer() {
  local package="$1"
  local install_dir="$packages_dir/$package/install"
  local units_manifest="$packages_dir/$package/user-units.manifest"
  local f base
  typeset -A unit_names accept_service_templates

  if [[ ! -d "$install_dir" ]]; then
    [[ -f "$units_manifest" ]] &&
      err "$package: has user-units.manifest but no install/ tree"
    return 0
  fi

  # Reject files Stow would silently skip (see is_stow_ignored): otherwise stow
  # omits them and verify/test then report the link as missing.
  local rel
  for f in "$install_dir"/**/*(DN.) "$install_dir"/**/*(DN@); do
    rel="${f#$install_dir/}"
    is_meta_file "$rel" && continue
    is_stow_ignored "$rel" &&
      err "$package: install file would be skipped by Stow (remove it): $rel"
  done

  load_units_manifest "$units_manifest" user
  unit_names=("${(@kv)manifest_paths}")
  accept_service_templates=()

  # Every user systemd unit file must be declared in user-units.manifest
  # (a template file satisfies any manifest entry that is an instance of it).
  for f in "$install_dir"/.config/systemd/user/*(N.); do
    base="${f:t}"
    case "$base" in
      *.service|*.timer|*.path|*.socket|*.mount|*.target)
        manifest_declares_unit "$base" ||
          err "$package: user systemd unit not in user-units.manifest: $base"
        ;;
    esac
  done

  # Reverse: every manifest entry must have a repo unit file (template instances resolve to their template file).
  for base in "${(@k)unit_names}"; do
    repo_unit_file_exists "$install_dir/.config/systemd/user" "$base" ||
      err "$package: user-units.manifest entry has no repo unit file: $base"
  done

  check_trigger_directives "$install_dir/.config/systemd/user" "user-units.manifest"
  for base in "${(@k)unit_names}"; do
    if is_template_unit_name "$base" && [[ "$base" == *.service && -z "${accept_service_templates[$base]-}" ]]; then
      err "$package: template service in user-units.manifest must be required by an Accept=yes socket: $base"
    fi
  done
}

# Shell startup files are never owned by any package (AGENTS.md): rejects a
# package shipping install/.zshrc or install/.profile, which stow would
# otherwise install as the user's ~/.zshrc or ~/.profile, silently bypassing
# the modular rc.d/profile.d bootstrap (scripts/ensure-rcd-loaders).
check_shell_startup_files() {
  local package="$1"
  local install_dir="$packages_dir/$package/install"
  local rel

  for rel in .zshrc .profile; do
    if [[ -e "$install_dir/$rel" || -L "$install_dir/$rel" ]]; then
      err "$package: must not ship install/$rel: shell startup files are not owned by any package (see AGENTS.md)"
    fi
  done
}

typeset -a packages_to_check
packages_to_check=()
(( $# > 0 )) && [[ "$1" == "--" ]] && shift

if (( $# > 0 )); then
  packages_to_check=("$@")
else
  typeset d
  for d in "$packages_dir"/*(N/); do
    packages_to_check+=("${d:t}")
  done
fi

_load_protected_paths
_load_allow_setid_paths
check_helper_parity

for package in "${packages_to_check[@]}"; do
  [[ -d "$packages_dir/$package" ]] || { err "unknown package: $package"; continue; }
  check_hooks "$package"
  check_system_layer "$package"
  check_user_layer "$package"
  check_shell_startup_files "$package"
done

if (( errors > 0 )); then
  print -u2 -- "$script_name: FAILED with $errors error(s)"
  exit 1
fi

print -- "$script_name: ok (${#packages_to_check[@]} package(s) checked)"
